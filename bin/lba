# Le paramètre `confirmed_by_user` est REQUIS (pas de défaut) et doit valoir
# EXACTEMENT `True` (booléen, pas une string "true"/1 qui indiquerait un agent
# qui shortcut la confirmation) — sinon _exec refuse d'appeler le backend AVANT
# même de construire la requête HTTP. Cf test_lba_auth_required_tools.py pour
# le verrou de régression sur cette garde.
_CONFIRMATION_REQUIRED_TOOLS = frozenset({"lba_devis_envoyer", "lba_direction_proposition_repondre"})

_CLI_SESSION_SECRET_PATH = os.environ.get(
    "LBA_CLI_SESSION_SECRET_PATH", "/home/damienldx/.lba-desktop/cli-session.secret"
)
_CLI_SESSION_TICKET_TTL_SEC = 60


def _seg(value) -> str:
    """Encode un segment de PATH (code/tiers_id/famille) — safe='' pour ne
    pas laisser passer un '/' ou un caractère spécial tel quel dans l'URL
    (même classe de bug que e63bc22)."""
    return quote(str(value), safe="")


class LbaCliError(Exception):
    """Erreur réseau/HTTP distincte d'une réponse vide — jamais avalée en silence."""


def _resolve_agent_id(explicit: str | None) -> str:
    """Identité du seat fleet appelant — jamais devinée. --agent-id explicite
    en priorité (usage manuel/test, même convention que pty_server.py
    --mint-ticket), sinon UBIK_AGENT_ID/RELAY_AGENT_ID (identité du seat
    courant, même convention que les tools relay_* — cf relay_send : "le
    sender est votre propre identité enregistrée")."""
    agent_id = explicit or os.environ.get("UBIK_AGENT_ID") or os.environ.get("RELAY_AGENT_ID")
    if not agent_id:
        raise LbaCliError(
            "impossible de résoudre l'agent_id du seat appelant "
            "(ni --agent-id, ni UBIK_AGENT_ID/RELAY_AGENT_ID) — requis pour les tools Graph/Todo"
        )
    return agent_id


def _mint_cli_session_jwt(agent_id: str) -> str:
    """Ticket-exchange (mission #3, décision arb_050496c8b4 option B) : mint
    localement une preuve HMAC courte (secret dédié, JAMAIS LBA_JWT_SECRET —
    même algorithme que pty_server.py::mint_ticket, agent_id:expiry), puis
    l'échange contre un VRAI JWT lba_session à TTL court auprès de
    POST /api/bacchus/cli/session (bacchus_cli_session.py). Le JWT résultant
    est scopé à l'email du TITULAIRE du seat `agent_id` — 403 si cet
    agent_id n'est rattaché à aucun seat business dédié (jamais un compte de
    service)."""
    try:
        with open(_CLI_SESSION_SECRET_PATH, "rb") as f:
            secret = f.read()
    except OSError as e:
        raise LbaCliError(
            f"secret CLI-session illisible ({_CLI_SESSION_SECRET_PATH}) — "
            f"le backend LBA-DESKTOP (bacchus_cli_session.py) n'a peut-être jamais démarré: {e}"
        ) from e
    if not secret:
        raise LbaCliError(f"secret CLI-session vide ({_CLI_SESSION_SECRET_PATH})")

    expiry = int(time.time()) + _CLI_SESSION_TICKET_TTL_SEC
    proof = hmac.new(secret, f"{agent_id}:{expiry}".encode(), sha256).hexdigest()

    body = json.dumps({"agent_id": agent_id, "expiry": expiry, "proof": proof}).encode()
    req = urllib.request.Request(
        f"{BASE}/api/bacchus/cli/session", data=body, method="POST",
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            resp = json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        detail = ""
        try:
            detail = e.read().decode(errors="replace")[:300]
        except Exception:
            pass
        raise LbaCliError(f"ticket-exchange échoué — HTTP {e.code} {e.reason}" + (f": {detail}" if detail else "")) from e
    except urllib.error.URLError as e:
        raise LbaCliError(f"ticket-exchange injoignable ({e.reason})") from e

    return resp["jwt"]


def _auth_headers(tool: str, agent_id: str | None) -> dict:
    """Header Authorization: Bearer <jwt> pour les tools Graph/Todo
    uniquement (whitelist _AUTH_REQUIRED_TOOLS) — les 18 tools DATA
    n'appellent jamais cette fonction, zéro régression sur leur flux."""
    if tool not in _AUTH_REQUIRED_TOOLS:
        return {}
    jwt_token = _mint_cli_session_jwt(_resolve_agent_id(agent_id))
    return {"Authorization": f"Bearer {jwt_token}"}


def _get(path: str, params: dict, headers: dict | None = None, timeout: int = 30) -> str:
    q = {k: v for k, v in params.items() if v is not None}
    url = f"{BASE}{path}"
    if q:
        url += "?" + urlencode(q)
    req = urllib.request.Request(url, method="GET", headers=headers or {})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.read().decode()
    except urllib.error.HTTPError as e:
        body = ""
        try:
            body = e.read().decode(errors="replace")[:500]
        except Exception:
            pass
        raise LbaCliError(f"GET {url} — HTTP {e.code} {e.reason}" + (f": {body}" if body else "")) from e
    except urllib.error.URLError as e:
        raise LbaCliError(f"GET {url} — injoignable ({e.reason})") from e


def _post(path: str, payload: dict, headers: dict | None = None, timeout: int = 30) -> str:
    return _write(path, payload, "POST", headers, timeout=timeout)


def _patch(path: str, payload: dict, headers: dict | None = None) -> str:
    return _write(path, payload, "PATCH", headers)


def _delete(path: str, headers: dict | None = None) -> str:
    """DELETE sans corps significatif (lba_procedure_supprimer) — l'endpoint
    backend ne déclare pas de payload, un body vide est ignoré sans risque."""
    return _write(path, {}, "DELETE", headers)


def _write(path: str, payload: dict, method: str, headers: dict | None = None, timeout: int = 30) -> str:
    url = f"{BASE}{path}"
    body = json.dumps(payload).encode()
    hdrs = {"Content-Type": "application/json", **(headers or {})}
    req = urllib.request.Request(url, data=body, method=method, headers=hdrs)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.read().decode()
    except urllib.error.HTTPError as e:
        body_txt = ""
        try:
            body_txt = e.read().decode(errors="replace")[:500]
        except Exception:
            pass
        raise LbaCliError(f"{method} {url} — HTTP {e.code} {e.reason}" + (f": {body_txt}" if body_txt else "")) from e
    except urllib.error.URLError as e:
        raise LbaCliError(f"{method} {url} — injoignable ({e.reason})") from e


def _req(args: dict, name: str):
    """Paramètre requis — erreur explicite plutôt qu'un KeyError opaque."""
    if name not in args or args[name] in (None, ""):
        raise LbaCliError(f"paramètre requis manquant: {name}")
    return args[name]


