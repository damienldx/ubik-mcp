_TOOLS_BY_NAME = {t["name"]: t for t in TOOLS}


def _exec(tool: str, args: dict):
    if tool == "lba_client_fiche":
        code = _seg(_req(args, "code"))
        return _get(f"/api/bacchus/client/{code}/fiche", {
            "date_from": _req(args, "date_from"), "date_to": _req(args, "date_to")})
    if tool == "lba_client_historique_visites":
        code = _seg(_req(args, "code"))
        return _get(f"/api/bacchus/client/{code}/historique-visites", {
            "date_from": args.get("date_from"), "date_to": args.get("date_to"),
            "limit": args.get("limit", 200)})
    if tool == "lba_client_recouvrement_statut":
        code = _seg(_req(args, "code"))
        return _get(f"/api/bacchus/client/{code}/recouvrement-statut", {})
    if tool == "lba_client_simulateur_prix":
        code = _seg(_req(args, "code"))
        famille = _seg(_req(args, "famille"))
        return _get(f"/api/bacchus/client/{code}/simulateur-prix/{famille}", {
            "date_from": args.get("date_from"), "date_to": args.get("date_to")})
    if tool == "lba_client_extrait_compte":
        tiers_id = _seg(_req(args, "tiers_id"))
        return _get(f"/api/bacchus/client/tiers/{tiers_id}/extrait-compte", {})
    if tool == "lba_client_relance_preview":
        tiers_id = _seg(_req(args, "tiers_id"))
        return _get(f"/api/bacchus/client/tiers/{tiers_id}/relance/preview", {
            "kind": args.get("kind", "relance")})
    if tool == "lba_rentabilite_produits":
        return _get("/api/bacchus/rentabilite/produits", {
            "annee": _req(args, "annee"), "representant": args.get("representant"),
            "famille": args.get("famille"), "sousfamille": args.get("sousfamille"),
            "q": args.get("q"), "limit": args.get("limit", 100), "offset": args.get("offset", 0)})
    if tool == "lba_rentabilite_clients":
        return _get("/api/bacchus/rentabilite/clients", {
            "annee": _req(args, "annee"), "representant": args.get("representant"),
            "q": args.get("q"), "limit": args.get("limit", 100), "offset": args.get("offset", 0)})
    if tool == "lba_tdc_kpis":
        return _get("/api/bacchus/rentabilite/tdc-kpis", {
            "granularite": args.get("granularite"), "periode_ref": args.get("periode_ref"),
            "months": args.get("months"), "rep_code": args.get("rep_code")})
    if tool == "lba_clients_sans_visites":
        return _get("/api/bacchus/portefeuille/clients-sans-visites", {
            "limit": args.get("limit", 500), "marque": args.get("marque")})
    if tool == "lba_produits_dormants":
        return _get("/api/bacchus/portefeuille/produits-dormants", {"limit": args.get("limit", 5000)})
    if tool == "lba_kpis_portefeuille":
        return _get("/api/bacchus/portefeuille/kpis", {
            "date_from": _req(args, "date_from"), "date_to": _req(args, "date_to"),
            "months": args.get("months")})
    if tool == "lba_dso_client":
        return _get("/api/bacchus/portefeuille/dso", {"code": args.get("code")})
    if tool == "lba_agenda_representants":
        return _get("/api/bacchus/portefeuille/agenda-representants", {"week": args.get("week")})
    if tool == "lba_portefeuille_liste":
        return _get("/api/bacchus/portefeuille/liste", {
            "days": args.get("days", 90), "limit": args.get("limit", 500)})
    if tool == "lba_recherche_client":
        return _get("/api/bacchus/recherche/client", {
            "q": _req(args, "q"), "limit": args.get("limit", 20)})
    if tool == "lba_analytics_explorer":
        return _get("/api/bacchus/analytics/explorer", {
            "kpis": args.get("kpis"), "rep": args.get("rep"), "rep_code": args.get("rep_code"),
            "famille": args.get("famille"), "article": args.get("article"),
            "granularite": args.get("granularite", "MOIS"), "n_points": args.get("n_points", 12)})
    if tool == "lba_rep_codes":
        return _get("/api/bacchus/admin/rep-codes", {})
    raise LbaCliError(f"tool inconnu: {tool} (voir `lba --list`)")


def main():
    p = argparse.ArgumentParser(prog="lba", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("tool", nargs="?", help="nom du tool lba_* (ex: lba_client_fiche)")
    p.add_argument("--args", help="arguments JSON du tool, ex: '{\"code\":\"DIRILA\"}'")
    p.add_argument("--list", action="store_true", help="liste les 18 tools (nom + description)")
    p.add_argument("--schema", action="store_true", help="imprime le schéma JSON du tool donné")
    a = p.parse_args()

    if a.list or not a.tool:
        print(json.dumps([{"name": t["name"], "description": t["description"]} for t in TOOLS],
                          indent=2, ensure_ascii=False))
        return

    if a.tool not in _TOOLS_BY_NAME:
        print(f"lba: tool inconnu: {a.tool!r} — voir `lba --list`", file=sys.stderr)
        sys.exit(2)

    if a.schema:
        print(json.dumps(_TOOLS_BY_NAME[a.tool]["inputSchema"], indent=2, ensure_ascii=False))
        return

    try:
        args = json.loads(a.args) if a.args else {}
    except json.JSONDecodeError as e:
        print(f"lba: --args invalide (JSON): {e}", file=sys.stderr)
        sys.exit(2)

    try:
        raw = _exec(a.tool, args)
    except LbaCliError as e:
        print(f"lba: {e}", file=sys.stderr)
        sys.exit(1)

    try:
        print(json.dumps(json.loads(raw), indent=2, ensure_ascii=False))
    except (json.JSONDecodeError, TypeError):
        print(raw)


if __name__ == "__main__":
    main()
