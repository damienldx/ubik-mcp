#!/usr/bin/env python3
"""lba — CLI sibling pour les tools DATA Bacchus (LBA Desktop), zéro MCP.

Mappe les 18 tools lba_* en lecture seule vers les endpoints non-authentifiés
:8504 /api/bacchus/* (plan_service.py, plan/bacchus_*_tools.py) — même
politique "CLI tools first" que `ubik`/`ubik-activity`/`ubik-peek`, mais
implanté comme sibling autonome (bin/lba, symlinké ~/.local/bin/lba) plutôt
qu'un namespace de plus dans bin/ubik : domaine LBA/Bacchus distinct du
tronc UBIK fleet, même schéma de câblage que ubik-peek/ubik-tty/ubik-wall.

Périmètre STRICT : les 18 tools DATA (client/rentabilité/portefeuille/
recherche/analytics/admin), tous sans Depends(current_user) côté backend.
Les tools Graph/Mail/Calendrier/Teams (auth réelle) sont hors scope — wave
suivante (mission séparée, cf brief #2 plan_9d722ce9).

Usage:
    lba <tool> --args '<json-object>'   # invoque un tool, retourne le JSON
    lba --list                          # liste les 18 tools (nom + description)
    lba <tool> --schema                 # imprime le schéma JSON d'un tool

Env: LBA_PLAN_BASE (défaut http://127.0.0.1:8504)
"""
from __future__ import annotations
import argparse
import json
import os
import sys
import urllib.error
import urllib.request
from urllib.parse import quote, urlencode

BASE = os.environ.get("LBA_PLAN_BASE", "http://127.0.0.1:8504")


def _seg(value) -> str:
    """Encode un segment de PATH (code/tiers_id/famille) — safe='' pour ne
    pas laisser passer un '/' ou un caractère spécial tel quel dans l'URL
    (même classe de bug que e63bc22)."""
    return quote(str(value), safe="")


class LbaCliError(Exception):
    """Erreur réseau/HTTP distincte d'une réponse vide — jamais avalée en silence."""


def _get(path: str, params: dict) -> str:
    q = {k: v for k, v in params.items() if v is not None}
    url = f"{BASE}{path}"
    if q:
        url += "?" + urlencode(q)
    req = urllib.request.Request(url, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return r.read().decode()
    except urllib.error.HTTPError as e:
        body = ""
        try:
            body = e.read().decode(errors="replace")[:500]
        except Exception:
            pass
        raise LbaCliError(f"GET {url} — HTTP {e.code} {e.reason}" + (f": {body}" if body else "")) from e
    except urllib.error.URLError as e:
        raise LbaCliError(f"GET {url} — injoignable ({e.reason})") from e


def _req(args: dict, name: str):
    """Paramètre requis — erreur explicite plutôt qu'un KeyError opaque."""
    if name not in args or args[name] in (None, ""):
        raise LbaCliError(f"paramètre requis manquant: {name}")
    return args[name]


