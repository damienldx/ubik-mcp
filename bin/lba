#!/usr/bin/env python3
"""lba — CLI sibling pour les tools DATA + Graph/Todo Bacchus (LBA Desktop),
zéro MCP.

Mappe les tools lba_* vers les endpoints :8504 /api/bacchus/* + /api/me/todo/*
(plan_service.py, plan/bacchus_*_tools.py) — même politique "CLI tools first"
que `ubik`/`ubik-activity`/`ubik-peek`, implanté comme sibling autonome
(bin/lba, symlinké ~/.local/bin/lba) plutôt qu'un namespace de plus dans
bin/ubik : domaine LBA/Bacchus distinct du tronc UBIK fleet, même schéma de
câblage que ubik-peek/ubik-tty/ubik-wall.

18 tools DATA (client/rentabilité/portefeuille/recherche/analytics/admin) —
mission #2 plan_9d722ce9, Caton — sans Depends(current_user) côté backend.

20 tools GRAPH/TODO (mail/calendrier/teams/todo/mission-request/visite/
procedures) — mission #3 plan_9d722ce9, Vidocq (10 initiaux) + mission #1
plan_91c9dfb4 (lba_mission_request, lba_todo_task_create) + mission #1
plan_13812401 (lba_visite_creer, POST /api/me/evenements, contrat CONTRACT_
ajout_manuel_visite.md) + mission #1 plan CLI Bridge Bacchus/procedures
(lba_procedure_creer/mine/modifier/supprimer/soumettre/liste/themes, 7 tools
— /api/me/procedures/* L9703-9802 lba_api.py + procedures_db.py ; volontai-
rement PAS de wrapper pour /api/me/procedures/queue ni /{id}/validate,
réservés backoffice@lba-boissons.fr Depends(_require_backoffice), hors
scope Bacchus/seat — jamais de compte de service backoffice) — EXIGENT Depends(current_user) réel (auth
Microsoft déléguée per-utilisateur, pas de compte de service). Le CLI porte
la session du TITULAIRE DU SEAT appelant via un ticket-exchange dédié (cf
_mint_cli_session_jwt ci-dessous — décision Damien arb_050496c8b4 option B,
mirroir du pattern bacchus_terminal_ticket.py/pty_server.py::mint_ticket,
secret DISTINCT de LBA_JWT_SECRET, jamais le secret maître de session ne
sort vers les seats). Résolution de l'agent_id appelant : env
UBIK_AGENT_ID/RELAY_AGENT_ID (identité du seat courant), ou --agent-id
explicite pour un usage manuel/test — jamais un agent_id arbitraire choisi
en dur, jamais de fallback silencieux sur un seat générique.

Usage:
    lba <tool> --args '<json-object>'   # invoque un tool, retourne le JSON
    lba --list                          # liste les tools (nom + description)
    lba <tool> --schema                 # imprime le schéma JSON d'un tool
    lba <tool> --args '...' --agent-id 22fcf4a5-agent-1   # override identité seat (tools Graph/Todo)

Env: LBA_PLAN_BASE (défaut http://127.0.0.1:8504), LBA_CLI_SESSION_SECRET_PATH
(défaut /home/damienldx/.lba-desktop/cli-session.secret — même chemin ABSOLU
que côté backend, cf bacchus_cli_session.py : un process CLI tournant dans un
seat fleet a son propre $HOME isolé, `~` n'y résoudrait PAS vers le même
fichier que le backend).
"""
from __future__ import annotations
import argparse
import hmac
import json
import os
import sys
import time
import urllib.error
import urllib.request
from hashlib import sha256
from urllib.parse import quote, urlencode

BASE = os.environ.get("LBA_PLAN_BASE", "http://127.0.0.1:8504")

# ── Tools Graph/Todo nécessitant une session réelle (mission #3) ───────────
# Whitelist POSITIVE : seuls ces noms déclenchent le ticket-exchange —
# les 18 tools DATA de Caton restent inchangés, zéro session requise.
_AUTH_REQUIRED_TOOLS = frozenset({
    "lba_mail_liste", "lba_mail_lire", "lba_mail_repondre",
    "lba_calendar_liste", "lba_calendar_creer",
    "lba_teams_conversations", "lba_teams_repondre",
    "lba_todo_lists", "lba_todo_tasks", "lba_todo_task_status",
    "lba_mission_request", "lba_todo_task_create", "lba_todo_task_delete",
    "lba_todo_task_due", "lba_visite_creer",
    "lba_visites_liste", "lba_visite_modifier",
    "lba_procedure_creer", "lba_procedure_mine", "lba_procedure_modifier",
    "lba_procedure_supprimer", "lba_procedure_soumettre",
    "lba_procedure_liste", "lba_procedure_themes",
    "lba_reunion_template", "lba_reunion_creer", "lba_reunion_liste",
    "lba_reunion_lire", "lba_reunion_modifier", "lba_reunion_supprimer",
})

_CLI_SESSION_SECRET_PATH = os.environ.get(
    "LBA_CLI_SESSION_SECRET_PATH", "/home/damienldx/.lba-desktop/cli-session.secret"
)
_CLI_SESSION_TICKET_TTL_SEC = 60


def _seg(value) -> str:
    """Encode un segment de PATH (code/tiers_id/famille) — safe='' pour ne
    pas laisser passer un '/' ou un caractère spécial tel quel dans l'URL
    (même classe de bug que e63bc22)."""
    return quote(str(value), safe="")


class LbaCliError(Exception):
    """Erreur réseau/HTTP distincte d'une réponse vide — jamais avalée en silence."""


def _resolve_agent_id(explicit: str | None) -> str:
    """Identité du seat fleet appelant — jamais devinée. --agent-id explicite
    en priorité (usage manuel/test, même convention que pty_server.py
    --mint-ticket), sinon UBIK_AGENT_ID/RELAY_AGENT_ID (identité du seat
    courant, même convention que les tools relay_* — cf relay_send : "le
    sender est votre propre identité enregistrée")."""
    agent_id = explicit or os.environ.get("UBIK_AGENT_ID") or os.environ.get("RELAY_AGENT_ID")
    if not agent_id:
        raise LbaCliError(
            "impossible de résoudre l'agent_id du seat appelant "
            "(ni --agent-id, ni UBIK_AGENT_ID/RELAY_AGENT_ID) — requis pour les tools Graph/Todo"
        )
    return agent_id


def _mint_cli_session_jwt(agent_id: str) -> str:
    """Ticket-exchange (mission #3, décision arb_050496c8b4 option B) : mint
    localement une preuve HMAC courte (secret dédié, JAMAIS LBA_JWT_SECRET —
    même algorithme que pty_server.py::mint_ticket, agent_id:expiry), puis
    l'échange contre un VRAI JWT lba_session à TTL court auprès de
    POST /api/bacchus/cli/session (bacchus_cli_session.py). Le JWT résultant
    est scopé à l'email du TITULAIRE du seat `agent_id` — 403 si cet
    agent_id n'est rattaché à aucun seat business dédié (jamais un compte de
    service)."""
    try:
        with open(_CLI_SESSION_SECRET_PATH, "rb") as f:
            secret = f.read()
    except OSError as e:
        raise LbaCliError(
            f"secret CLI-session illisible ({_CLI_SESSION_SECRET_PATH}) — "
            f"le backend LBA-DESKTOP (bacchus_cli_session.py) n'a peut-être jamais démarré: {e}"
        ) from e
    if not secret:
        raise LbaCliError(f"secret CLI-session vide ({_CLI_SESSION_SECRET_PATH})")

    expiry = int(time.time()) + _CLI_SESSION_TICKET_TTL_SEC
    proof = hmac.new(secret, f"{agent_id}:{expiry}".encode(), sha256).hexdigest()

    body = json.dumps({"agent_id": agent_id, "expiry": expiry, "proof": proof}).encode()
    req = urllib.request.Request(
        f"{BASE}/api/bacchus/cli/session", data=body, method="POST",
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            resp = json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        detail = ""
        try:
            detail = e.read().decode(errors="replace")[:300]
        except Exception:
            pass
        raise LbaCliError(f"ticket-exchange échoué — HTTP {e.code} {e.reason}" + (f": {detail}" if detail else "")) from e
    except urllib.error.URLError as e:
        raise LbaCliError(f"ticket-exchange injoignable ({e.reason})") from e

    return resp["jwt"]


def _auth_headers(tool: str, agent_id: str | None) -> dict:
    """Header Authorization: Bearer <jwt> pour les tools Graph/Todo
    uniquement (whitelist _AUTH_REQUIRED_TOOLS) — les 18 tools DATA
    n'appellent jamais cette fonction, zéro régression sur leur flux."""
    if tool not in _AUTH_REQUIRED_TOOLS:
        return {}
    jwt_token = _mint_cli_session_jwt(_resolve_agent_id(agent_id))
    return {"Authorization": f"Bearer {jwt_token}"}


def _get(path: str, params: dict, headers: dict | None = None) -> str:
    q = {k: v for k, v in params.items() if v is not None}
    url = f"{BASE}{path}"
    if q:
        url += "?" + urlencode(q)
    req = urllib.request.Request(url, method="GET", headers=headers or {})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return r.read().decode()
    except urllib.error.HTTPError as e:
        body = ""
        try:
            body = e.read().decode(errors="replace")[:500]
        except Exception:
            pass
        raise LbaCliError(f"GET {url} — HTTP {e.code} {e.reason}" + (f": {body}" if body else "")) from e
    except urllib.error.URLError as e:
        raise LbaCliError(f"GET {url} — injoignable ({e.reason})") from e


def _post(path: str, payload: dict, headers: dict | None = None) -> str:
    return _write(path, payload, "POST", headers)


def _patch(path: str, payload: dict, headers: dict | None = None) -> str:
    return _write(path, payload, "PATCH", headers)


def _delete(path: str, headers: dict | None = None) -> str:
    """DELETE sans corps significatif (lba_procedure_supprimer) — l'endpoint
    backend ne déclare pas de payload, un body vide est ignoré sans risque."""
    return _write(path, {}, "DELETE", headers)


def _write(path: str, payload: dict, method: str, headers: dict | None = None) -> str:
    url = f"{BASE}{path}"
    body = json.dumps(payload).encode()
    hdrs = {"Content-Type": "application/json", **(headers or {})}
    req = urllib.request.Request(url, data=body, method=method, headers=hdrs)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return r.read().decode()
    except urllib.error.HTTPError as e:
        body_txt = ""
        try:
            body_txt = e.read().decode(errors="replace")[:500]
        except Exception:
            pass
        raise LbaCliError(f"{method} {url} — HTTP {e.code} {e.reason}" + (f": {body_txt}" if body_txt else "")) from e
    except urllib.error.URLError as e:
        raise LbaCliError(f"{method} {url} — injoignable ({e.reason})") from e


def _req(args: dict, name: str):
    """Paramètre requis — erreur explicite plutôt qu'un KeyError opaque."""
    if name not in args or args[name] in (None, ""):
        raise LbaCliError(f"paramètre requis manquant: {name}")
    return args[name]


