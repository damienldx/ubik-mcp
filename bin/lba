_TOOLS_BY_NAME = {t["name"]: t for t in TOOLS}


def _exec(tool: str, args: dict, agent_id: str | None = None):
    if tool in _CONFIRMATION_REQUIRED_TOOLS and args.get("confirmed_by_user") is not True:
        raise LbaCliError(
            f"{tool} refusé : confirmed_by_user doit valoir true, et doit refléter une "
            "confirmation RÉELLEMENT obtenue de l'utilisateur juste avant cet appel — "
            "pas de valeur par défaut, pas d'automatisme. Aucune requête HTTP émise "
            "(refus AVANT le ticket-exchange, zéro effet de bord)."
        )
    headers = _auth_headers(tool, agent_id)
    if tool == "lba_mail_liste":
        return _get("/api/bacchus/mail/liste", {
            "top": args.get("top", 25), "page_token": args.get("page_token")}, headers)
    if tool == "lba_mail_lire":
        message_id = _req(args, "message_id")
        return _get(f"/api/bacchus/mail/{message_id}", {}, headers)
    if tool == "lba_mail_repondre":
        message_id = _req(args, "message_id")
        return _post(f"/api/bacchus/mail/{message_id}/repondre", {
            "comment": _req(args, "comment"), "reply_all": args.get("reply_all", False)}, headers)
    if tool == "lba_mail_marquer":
        message_id = _req(args, "message_id")
        return _patch(f"/api/bacchus/mail/{message_id}/marquer", {
            "status": args.get("status", "flagged")}, headers)
    if tool == "lba_mail_dossiers_lister":
        return _get("/api/bacchus/mail/dossiers", {}, headers)
    if tool == "lba_mail_rechercher":
        return _get("/api/bacchus/mail/rechercher", {
            "q": args.get("q"), "dossier_id": args.get("dossier_id"), "top": args.get("top", 25)}, headers)
    if tool == "lba_mail_pieces_jointes_lister":
        message_id = _req(args, "message_id")
        return _get(f"/api/bacchus/mail/{message_id}/pieces-jointes", {}, headers)
    if tool == "lba_mail_piece_jointe_telecharger":
        message_id = _req(args, "message_id")
        attachment_id = _req(args, "attachment_id")
        return _post(f"/api/bacchus/mail/{message_id}/pieces-jointes/{attachment_id}/telecharger", {}, headers)
    if tool == "lba_mail_envoyer":
        return _post("/api/bacchus/mail/envoyer", {
            "to": _req(args, "to"), "subject": _req(args, "subject"), "body": _req(args, "body"),
            "cc": args.get("cc"), "is_html": args.get("is_html", False)}, headers)
    if tool == "lba_whatsapp_envoyer":
        return _post("/api/bacchus/whatsapp/envoyer", {
            "chatId": _req(args, "chatId"), "message": _req(args, "message")}, headers)
    if tool == "lba_whatsapp_liste":
        return _get("/api/bacchus/whatsapp/liste", {"limit": args.get("limit")}, headers)
    if tool == "lba_whatsapp_lire":
        chat_id = _req(args, "chat_id")
        return _get(f"/api/bacchus/whatsapp/{_seg(chat_id)}/lire", {"limit": args.get("limit")}, headers)
    if tool == "lba_whatsapp_piece_jointe_telecharger":
        message_id = _req(args, "message_id")
        return _get(f"/api/bacchus/whatsapp/{_seg(message_id)}/media", {}, headers)
    if tool == "lba_calendar_liste":
        return _get("/api/bacchus/calendar/liste", {
            "top": args.get("top", 20), "start_date_time": args.get("start_date_time"),
            "end_date_time": args.get("end_date_time")}, headers)
    if tool == "lba_calendar_creer":
        return _post("/api/bacchus/calendar/creer", {
            "subject": _req(args, "subject"), "start": _req(args, "start"), "end": _req(args, "end"),
            "timeZone": args.get("timeZone"), "body": args.get("body"), "isHtml": args.get("isHtml", False),
            "attendees": args.get("attendees"), "isOnlineMeeting": args.get("isOnlineMeeting", False)}, headers)
    if tool == "lba_prospect_creer":
        return _post("/api/bacchus/prospects/creer", {
            "raison_sociale": _req(args, "raison_sociale"), "nom_commercial": args.get("nom_commercial"),
            "siret": args.get("siret"), "telephone": args.get("telephone"), "email": args.get("email"),
            "site_internet": args.get("site_internet"), "commentaire": args.get("commentaire"),
            "adresses": args.get("adresses", []), "contacts": args.get("contacts", []),
            "origine_pipeline_ia": args.get("origine_pipeline_ia", False)}, headers)
    if tool == "lba_prospect_passer_client":
        return _post("/api/bacchus/prospects/passer-client", {
            "tiers_id": _req(args, "tiers_id"), "tva_intra_com": args.get("tva_intra_com"),
            "regime_tva": args.get("regime_tva"), "langue": args.get("langue"),
            "iban": args.get("iban"), "bic": args.get("bic"),
            "mode_reglement": args.get("mode_reglement"), "echeance_nb_jours": args.get("echeance_nb_jours"),
            "domiciliation_bancaire": args.get("domiciliation_bancaire"), "rib": args.get("rib"),
            "lier_adresse_existante": args.get("lier_adresse_existante", True)}, headers)
    if tool == "lba_referentiel_familles_client":
        return _get("/api/bacchus/referentiel/familles-client", {}, headers)
    if tool == "lba_referentiel_tarifs":
