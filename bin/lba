            "r1_cible": _req(args, "r1_cible"),
            "r2_cible": args.get("r2_cible", 0.0), "num_tarif_cible": args.get("num_tarif_cible", 18),
            "marge_cible": args.get("marge_cible")})
    if tool == "lba_tarifs_t19_harmonisation_appliquer":
        agent_id = _resolve_agent_id(args.get("agent_id"))
        return _post("/api/bacchus/tarifs/t19-harmonisation/appliquer", {
            "agent_id": agent_id, "sous_famille": args.get("sous_famille"),
            "code_article": args.get("code_article"),
            "num_tarif_cible": args.get("num_tarif_cible", 18),
            "r1_cible": _req(args, "r1_cible"), "r2_cible": args.get("r2_cible", 0.0),
            "marge_cible": args.get("marge_cible"),
            "confirm": bool(_req(args, "confirm"))})
    if tool == "lba_memoire_save":
        agent_id = _resolve_agent_id(args.get("agent_id"))
        return _post("/api/bacchus/memoire/save", {
            "agent_id": agent_id, "fait": _req(args, "fait"),
            "code_client": args.get("code_client"), "categorie": args.get("categorie")})
    if tool == "lba_memoire_recall":
        agent_id = _resolve_agent_id(args.get("agent_id"))
        return _get("/api/bacchus/memoire/recall", {
            "agent_id": agent_id, "query": _req(args, "query"),
            "code_client": args.get("code_client"), "limit": args.get("limit", 10)})
    if tool == "lba_skill_save":
        agent_id = _resolve_agent_id(args.get("agent_id"))
        payload = {
            "agent_id": agent_id, "nom": _req(args, "nom"),
            "description": _req(args, "description"), "contenu": _req(args, "contenu")}
        if args.get("domaine"):
            payload["domaine"] = args["domaine"]
        return _post("/api/bacchus/skills/save", payload)
    if tool == "lba_skill_liste":
        return _get("/api/bacchus/skills/liste", {"limit": args.get("limit", 100)})
    if tool == "lba_skill_charger":
        return _get("/api/bacchus/skills/charger", {
            "nom": args.get("nom"), "query": args.get("query"), "limit": args.get("limit", 5)})
    if tool == "lba_dossier_liste":
        return _get("/api/lba-docs/ls", {"path": args.get("path", ".")})
    if tool == "lba_dossier_arbre":
        return _get("/api/lba-docs/tree", {"path": args.get("path", "."), "max_depth": args.get("max_depth", 3)})
    if tool == "lba_dossier_lire":
        return _get("/api/lba-docs/read", {"path": _req(args, "path"), "max_chars": args.get("max_chars", 20000)})
    if tool == "lba_dossier_rechercher":
        return _post("/api/lba-docs/search", {
            "query": _req(args, "query"), "limit": args.get("limit", 8), "path_prefix": args.get("path_prefix")})
    if tool == "lba_dossier_creer":
        return _post("/api/lba-docs/mkdir", {"path": _req(args, "path")})
    if tool == "lba_dossier_archiver":
        agent_id = _resolve_agent_id(args.get("agent_id"))
        return _post("/api/lba-docs/archiver", {
            "local_path": _req(args, "local_path"), "path": _req(args, "path"),
            "filename": args.get("filename"), "agent_id": agent_id})
    if tool == "lba_dossier_note":
        agent_id = _resolve_agent_id(args.get("agent_id"))
        return _post("/api/lba-docs/note", {
            "path": _req(args, "path"), "filename": _req(args, "filename"),
            "contenu": _req(args, "contenu"), "agent_id": agent_id})
    if tool == "lba_investissement_snapshot":
        return _get("/api/bacchus/investissement/snapshot", {"code": _req(args, "code")})
    if tool == "lba_investissement_generer":
        return _post("/api/bacchus/investissement/generer", {
            "code": _req(args, "code"), "demande_faite_par": args.get("demande_faite_par"),
            "statut": _req(args, "statut"), "nature_investissement": _req(args, "nature_investissement"),
            "etat_materiel": _req(args, "etat_materiel"),
            "nombre_groupes_ou_becs": _req(args, "nombre_groupes_ou_becs"),
            "marque_industriel": _req(args, "marque_industriel"),
            "produit_specifique": args.get("produit_specifique"),
            "volume_annuel_cible": _req(args, "volume_annuel_cible"),
            "materiel_existant_a_retirer": args.get("materiel_existant_a_retirer", False),
            "financement": _req(args, "financement"),
            "commentaire": args.get("commentaire", ""),
            "date_demande": args.get("date_demande"),
            "nom_gerant_override": args.get("nom_gerant_override"),
            "telephone_override": args.get("telephone_override"),
            "adresse": args.get("adresse"), "code_postal": args.get("code_postal"),
            "ville": args.get("ville")})
    if tool == "lba_direction_proposition_creer":
        # owner_email n'est PLUS transmis ici (2026-08-31, correctif LEAD,
        # cf ledger) — la route dérive désormais TOUJOURS le collaborateur
        # depuis le JWT ticket-exchange (`headers` ci-dessus, même
        # mécanisme que lister/respond), jamais un champ déclaratif du
        # payload. Un champ owner_email pouvait être silencieusement
        # droppé par un bug de câblage (comme ça a été le cas depuis la
        # généralisation multi-seat du 30/08) SANS que rien côté serveur
        # ne le détecte — plus de classe de bug possible désormais, la
        # source de vérité est l'identité authentifiée, pas une valeur
        # que le CLI doit se souvenir de transmettre.
        return _post("/api/direction/propositions", {
            "type": _req(args, "type"), "titre": _req(args, "titre"),
            "action_proposee": _req(args, "action_proposee"),
            "contexte": args.get("contexte"), "options": args.get("options"),
            "origin_link": args.get("origin_link")}, headers)
    if tool == "lba_direction_propositions_lister":
        return _get("/api/direction/propositions", {"statut": args.get("statut")}, headers)
    if tool == "lba_direction_proposition_repondre":
        proposition_id = _req(args, "proposition_id")
        return _post(f"/api/direction/propositions/{_seg(proposition_id)}/respond", {
            "statut": _req(args, "statut"), "decision": args.get("decision"),
            "commentaire": args.get("commentaire"), "responsable_id": args.get("responsable_id"),
            "canal": args.get("canal"), "message_final": args.get("message_final")}, headers)
    if tool == "lba_direction_synthese_lire":
        return _get("/api/direction/synthese/latest", {}, headers)
    if tool == "lba_connaissances_rechercher":
        return _get("/api/direction/connaissances", {
            "mots_cles": args.get("mots_cles"), "client_ou_entite": args.get("client_ou_entite"),
            "limit": args.get("limit", 50)}, headers)
    if tool == "lba_connaissances_ajouter":
        return _post("/api/direction/connaissances", {
            "sujet": _req(args, "sujet"), "contexte": args.get("contexte"),
            "client_ou_entite": args.get("client_ou_entite"), "origin_link": args.get("origin_link")},
            headers)
    if tool == "lba_equipe_synthese_periode":
        return _get("/api/direction/connaissances/periode", {
            "date_debut": _req(args, "date_debut"), "date_fin": _req(args, "date_fin"),
            "limit": args.get("limit", 200)}, headers)
    if tool == "lba_historique_rechercher":
        return _get("/api/direction/knowledge", {
            "mots_cles": args.get("mots_cles"), "canal": args.get("canal"),
            "client_code": args.get("client_code"), "limit": args.get("limit", 50)}, headers)
    if tool == "lba_historique_fil_lire":
        return _get("/api/direction/knowledge/fil", {
            "item_id_prefix": _req(args, "item_id_prefix"), "limit": args.get("limit", 200)}, headers)
    raise LbaCliError(f"tool inconnu: {tool} (voir `lba --list`)")


def main():
    p = argparse.ArgumentParser(prog="lba", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("tool", nargs="?", help="nom du tool lba_* (ex: lba_client_fiche)")
    p.add_argument("--args", help="arguments JSON du tool, ex: '{\"code\":\"DIRILA\"}'")
    p.add_argument("--list", action="store_true", help="liste les tools (nom + description)")
    p.add_argument("--schema", action="store_true", help="imprime le schéma JSON du tool donné")
    p.add_argument("--agent-id", help="override l'identité du seat appelant (tools Graph/Todo uniquement — "
                                       "défaut UBIK_AGENT_ID/RELAY_AGENT_ID)")
    a = p.parse_args()

    if a.list or not a.tool:
        print(json.dumps([{"name": t["name"], "description": t["description"]} for t in TOOLS],
                          indent=2, ensure_ascii=False))
        return

    if a.tool not in _TOOLS_BY_NAME:
        print(f"lba: tool inconnu: {a.tool!r} — voir `lba --list`", file=sys.stderr)
        sys.exit(2)

    if a.schema:
        print(json.dumps(_TOOLS_BY_NAME[a.tool]["inputSchema"], indent=2, ensure_ascii=False))
        return

    try:
        args = json.loads(a.args) if a.args else {}
    except json.JSONDecodeError as e:
        print(f"lba: --args invalide (JSON): {e}", file=sys.stderr)
        sys.exit(2)

    try:
        raw = _exec(a.tool, args, agent_id=a.agent_id)
    except LbaCliError as e:
        print(f"lba: {e}", file=sys.stderr)
        sys.exit(1)

    try:
        print(json.dumps(json.loads(raw), indent=2, ensure_ascii=False))
    except (json.JSONDecodeError, TypeError):
        print(raw)


if __name__ == "__main__":
    main()
