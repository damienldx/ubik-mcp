_TOOLS_BY_NAME = {t["name"]: t for t in TOOLS}


def _exec(tool: str, args: dict, agent_id: str | None = None):
    headers = _auth_headers(tool, agent_id)
    if tool == "lba_mail_liste":
        return _get("/api/bacchus/mail/liste", {
            "top": args.get("top", 25), "page_token": args.get("page_token")}, headers)
    if tool == "lba_mail_lire":
        message_id = _req(args, "message_id")
        return _get(f"/api/bacchus/mail/{message_id}", {}, headers)
    if tool == "lba_mail_repondre":
        message_id = _req(args, "message_id")
        return _post(f"/api/bacchus/mail/{message_id}/repondre", {
            "comment": _req(args, "comment"), "reply_all": args.get("reply_all", False)}, headers)
    if tool == "lba_calendar_liste":
        return _get("/api/bacchus/calendar/liste", {
            "top": args.get("top", 20), "start_date_time": args.get("start_date_time"),
            "end_date_time": args.get("end_date_time")}, headers)
    if tool == "lba_calendar_creer":
        return _post("/api/bacchus/calendar/creer", {
            "subject": _req(args, "subject"), "start": _req(args, "start"), "end": _req(args, "end"),
            "timeZone": args.get("timeZone"), "body": args.get("body"), "isHtml": args.get("isHtml", False),
            "attendees": args.get("attendees")}, headers)
    if tool == "lba_teams_conversations":
        return _get("/api/bacchus/teams/conversations", {"top": args.get("top", 20)}, headers)
    if tool == "lba_teams_repondre":
        return _post("/api/bacchus/teams/repondre", {
            "chat_id": _req(args, "chat_id"), "message": _req(args, "message")}, headers)
    if tool == "lba_todo_lists":
        return _get("/api/me/todo/lists", {}, headers)
    if tool == "lba_todo_tasks":
        list_id = _req(args, "list_id")
        return _get(f"/api/me/todo/lists/{list_id}/tasks", {
            "includeCompleted": args.get("include_completed", False)}, headers)
    if tool == "lba_todo_task_status":
        task_id = _req(args, "task_id")
        return _patch(f"/api/me/todo/tasks/{task_id}/status", {
            "status": _req(args, "status"), "importance": args.get("importance"),
            "list_id": args.get("list_id")}, headers)
    if tool == "lba_todo_task_delete":
        task_id = _req(args, "task_id")
        path = f"/api/me/todo/tasks/{task_id}"
        list_id = args.get("list_id")
        if list_id:
            path += "?" + urlencode({"list_id": list_id})
        return _delete(path, headers)
    if tool == "lba_todo_task_due":
        task_id = _req(args, "task_id")
        return _patch(f"/api/me/todo/tasks/{task_id}/due", {
            "dueDateTime": args.get("dueDateTime"), "timeZone": args.get("timeZone"),
            "list_id": args.get("list_id")}, headers)
    if tool == "lba_mission_request":
        return _post("/api/me/missions/request", {
            "destinataire_email": _req(args, "destinataire_email"), "titre": _req(args, "titre"),
            "description": args.get("description"), "importance": args.get("importance")}, headers)
    if tool == "lba_todo_task_create":
        list_id = _req(args, "list_id")
        return _post(f"/api/me/todo/lists/{list_id}/tasks", {
            "title": _req(args, "title"), "importance": args.get("importance"),
            "dueDateTime": args.get("dueDateTime"), "timeZone": args.get("timeZone"),
            "body": args.get("body")}, headers)
    if tool == "lba_visite_creer":
        # Champs optionnels omis (pas envoyés en null) si absents : le backend
        # (EvenementCreate côté prisma-api) applique ses défauts ("Rendez-vous",
        # "SORTANT", "Non traité", idUtilisateur auto-injecté du JWT) uniquement
        # quand la clé est absente du payload — un null explicite écraserait ces
        # défauts au lieu de les laisser s'appliquer.
        raw = {
            "libelle": _req(args, "libelle"), "date": _req(args, "date"),
            "idUtilisateur": args.get("idUtilisateur"),
            "type": args.get("type"), "sens": args.get("sens"), "etat": args.get("etat"),
            "idContact": args.get("idContact"), "idSocieteAffectation": args.get("idSocieteAffectation"),
            "idRequete": args.get("idRequete"), "datedebut": args.get("datedebut"),
            "datefin": args.get("datefin"), "observations": args.get("observations")}
        payload = {k: v for k, v in raw.items() if v is not None}
        return _post("/api/me/evenements", payload, headers)
    if tool == "lba_visites_liste":
        # Défaut CLI 30j (vs 365 backend) : usage conversationnel — la fenêtre
        # large upstream cap à 2000 lignes et noie la réponse. Le filtre etat
        # est appliqué côté backend (absent = Traité only, défaut historique).
        # period_end INCLUSIF côté CLI : upstream PRISMA compare date < date_to
        # pour les RDV horodatés (vérifié 2026-07-24 : 25→25 = 0 row, 25→26 =
        # 1 row pour un RDV le 25 à 09:00) — on envoie J+1 au backend.
        period_end = args.get("period_end")
        if period_end:
            from datetime import date as _d, timedelta as _td
            period_end = str(_d.fromisoformat(period_end) + _td(days=1))
        return _get("/api/me/evenements", {
            "period_start": args.get("period_start"),
            "period_end": period_end,
            "days_back": args.get("days_back", 30),
            "months": args.get("months"), "rep_code": args.get("rep_code"),
            "etat": args.get("etat")}, headers)
    if tool == "lba_visite_modifier":
        es_id = _req(args, "es_id")
        raw = {"etat": args.get("etat"), "observations": args.get("observations"),
               "libelle": args.get("libelle"), "type": args.get("type"), "sens": args.get("sens"),
               "date": args.get("date"), "datedebut": args.get("datedebut"),
               "datefin": args.get("datefin"), "idContact": args.get("idContact"),
               "idSocieteAffectation": args.get("idSocieteAffectation")}
        payload = {k: v for k, v in raw.items() if v is not None}
        if not payload:
            raise LbaCliError("aucun champ à modifier — fournir au moins etat/observations/…")
        return _patch(f"/api/me/evenements/{int(es_id)}", payload, headers)
    if tool == "lba_procedure_creer":
        return _post("/api/me/procedures", {
            "titre": _req(args, "titre"), "theme": _req(args, "theme"),
            "contenu": _req(args, "contenu")}, headers)
    if tool == "lba_procedure_mine":
        return _get("/api/me/procedures/mine", {}, headers)
    if tool == "lba_procedure_modifier":
        procedure_id = _req(args, "procedure_id")
        raw = {"titre": args.get("titre"), "theme": args.get("theme"), "contenu": args.get("contenu")}
        payload = {k: v for k, v in raw.items() if v is not None}
        return _patch(f"/api/me/procedures/{procedure_id}", payload, headers)
    if tool == "lba_procedure_supprimer":
        procedure_id = _req(args, "procedure_id")
        return _delete(f"/api/me/procedures/{procedure_id}", headers)
    if tool == "lba_procedure_soumettre":
        procedure_id = _req(args, "procedure_id")
        return _post(f"/api/me/procedures/{procedure_id}/submit", {}, headers)
    if tool == "lba_procedure_liste":
        return _get("/api/me/procedures", {"theme": args.get("theme")}, headers)
    if tool == "lba_procedure_themes":
        return _get("/api/me/procedures/themes", {}, headers)
    if tool == "lba_reunion_template":
        return _get("/api/me/reunions/template", {
            "orientation": args.get("orientation", "paysage")}, headers)
    if tool == "lba_reunion_creer":
        raw = {"titre": _req(args, "titre"), "html": _req(args, "html"),
               "type": args.get("type"), "orientation": args.get("orientation"),
               "date_reunion": args.get("date_reunion")}
        return _post("/api/me/reunions", {k: v for k, v in raw.items() if v is not None}, headers)
    if tool == "lba_reunion_liste":
        return _get("/api/me/reunions", {
            "type": args.get("type"), "limit": args.get("limit"),
            "offset": args.get("offset")}, headers)
    if tool == "lba_reunion_lire":
        reunion_id = _seg(_req(args, "reunion_id"))
        return _get(f"/api/me/reunions/{reunion_id}", {}, headers)
    if tool == "lba_reunion_modifier":
        reunion_id = _seg(_req(args, "reunion_id"))
        raw = {"titre": args.get("titre"), "html": args.get("html"),
               "type": args.get("type"), "orientation": args.get("orientation"),
               "date_reunion": args.get("date_reunion")}
        payload = {k: v for k, v in raw.items() if v is not None}
        if not payload:
            raise LbaCliError("aucun champ à modifier — fournir au moins titre/html/type/orientation/date_reunion")
        return _patch(f"/api/me/reunions/{reunion_id}", payload, headers)
    if tool == "lba_reunion_supprimer":
        reunion_id = _seg(_req(args, "reunion_id"))
        return _delete(f"/api/me/reunions/{reunion_id}", headers)
    if tool == "lba_client_fiche":
        code = _seg(_req(args, "code"))
        return _get(f"/api/bacchus/client/{code}/fiche", {
            "date_from": _req(args, "date_from"), "date_to": _req(args, "date_to")})
    if tool == "lba_client_historique_visites":
        code = _seg(_req(args, "code"))
        return _get(f"/api/bacchus/client/{code}/historique-visites", {
            "date_from": args.get("date_from"), "date_to": args.get("date_to"),
            "limit": args.get("limit", 200)})
    if tool == "lba_client_recouvrement_statut":
        code = _seg(_req(args, "code"))
        return _get(f"/api/bacchus/client/{code}/recouvrement-statut", {})
    if tool == "lba_client_simulateur_prix":
        code = _seg(_req(args, "code"))
        famille = _seg(_req(args, "famille"))
        return _get(f"/api/bacchus/client/{code}/simulateur-prix/{famille}", {
            "date_from": args.get("date_from"), "date_to": args.get("date_to")})
    if tool == "lba_client_extrait_compte":
        tiers_id = _seg(_req(args, "tiers_id"))
        return _get(f"/api/bacchus/client/tiers/{tiers_id}/extrait-compte", {})
    if tool == "lba_client_relance_preview":
        tiers_id = _seg(_req(args, "tiers_id"))
        return _get(f"/api/bacchus/client/tiers/{tiers_id}/relance/preview", {
            "kind": args.get("kind", "relance")})
    if tool == "lba_rentabilite_produits":
        return _get("/api/bacchus/rentabilite/produits", {
            "annee": _req(args, "annee"), "representant": args.get("representant"),
            "famille": args.get("famille"), "sousfamille": args.get("sousfamille"),
            "q": args.get("q"), "limit": args.get("limit", 100), "offset": args.get("offset", 0)})
    if tool == "lba_rentabilite_clients":
        return _get("/api/bacchus/rentabilite/clients", {
            "annee": _req(args, "annee"), "representant": args.get("representant"),
            "q": args.get("q"), "limit": args.get("limit", 100), "offset": args.get("offset", 0)})
    if tool == "lba_tdc_kpis":
        return _get("/api/bacchus/rentabilite/tdc-kpis", {
            "granularite": args.get("granularite"), "periode_ref": args.get("periode_ref"),
            "months": args.get("months"), "rep_code": args.get("rep_code")})
    if tool == "lba_clients_sans_visites":
        return _get("/api/bacchus/portefeuille/clients-sans-visites", {
            "limit": args.get("limit", 500), "marque": args.get("marque")})
    if tool == "lba_produits_dormants":
        return _get("/api/bacchus/portefeuille/produits-dormants", {"limit": args.get("limit", 5000)})
    if tool == "lba_kpis_portefeuille":
        return _get("/api/bacchus/portefeuille/kpis", {
            "date_from": _req(args, "date_from"), "date_to": _req(args, "date_to"),
            "months": args.get("months")})
    if tool == "lba_dso_client":
        return _get("/api/bacchus/portefeuille/dso", {"code": args.get("code")})
    if tool == "lba_agenda_representants":
        return _get("/api/bacchus/portefeuille/agenda-representants", {"week": args.get("week")})
    if tool == "lba_portefeuille_liste":
        return _get("/api/bacchus/portefeuille/liste", {
            "days": args.get("days", 90), "limit": args.get("limit", 500)})
    if tool == "lba_recherche_client":
        return _get("/api/bacchus/recherche/client", {
            "q": _req(args, "q"), "limit": args.get("limit", 20)})
    if tool == "lba_analytics_explorer":
        return _get("/api/bacchus/analytics/explorer", {
            "kpis": args.get("kpis"), "rep": args.get("rep"), "rep_code": args.get("rep_code"),
            "famille": args.get("famille"), "article": args.get("article"),
            "granularite": args.get("granularite", "MOIS"), "n_points": args.get("n_points", 12)})
    if tool == "lba_rep_codes":
        return _get("/api/bacchus/admin/rep-codes", {})
    raise LbaCliError(f"tool inconnu: {tool} (voir `lba --list`)")


def main():
    p = argparse.ArgumentParser(prog="lba", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("tool", nargs="?", help="nom du tool lba_* (ex: lba_client_fiche)")
    p.add_argument("--args", help="arguments JSON du tool, ex: '{\"code\":\"DIRILA\"}'")
    p.add_argument("--list", action="store_true", help="liste les tools (nom + description)")
    p.add_argument("--schema", action="store_true", help="imprime le schéma JSON du tool donné")
    p.add_argument("--agent-id", help="override l'identité du seat appelant (tools Graph/Todo uniquement — "
                                       "défaut UBIK_AGENT_ID/RELAY_AGENT_ID)")
    a = p.parse_args()

    if a.list or not a.tool:
        print(json.dumps([{"name": t["name"], "description": t["description"]} for t in TOOLS],
                          indent=2, ensure_ascii=False))
        return

    if a.tool not in _TOOLS_BY_NAME:
        print(f"lba: tool inconnu: {a.tool!r} — voir `lba --list`", file=sys.stderr)
        sys.exit(2)

    if a.schema:
        print(json.dumps(_TOOLS_BY_NAME[a.tool]["inputSchema"], indent=2, ensure_ascii=False))
        return

    try:
        args = json.loads(a.args) if a.args else {}
    except json.JSONDecodeError as e:
        print(f"lba: --args invalide (JSON): {e}", file=sys.stderr)
        sys.exit(2)

    try:
        raw = _exec(a.tool, args, agent_id=a.agent_id)
    except LbaCliError as e:
        print(f"lba: {e}", file=sys.stderr)
        sys.exit(1)

    try:
        print(json.dumps(json.loads(raw), indent=2, ensure_ascii=False))
    except (json.JSONDecodeError, TypeError):
        print(raw)


if __name__ == "__main__":
    main()
