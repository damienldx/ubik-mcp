def _os_handoff(args):
    todos = _os_todos_text()
    decisions = _os_decisions_text(5)
    sprints = _os_sprints_text()
    return ("🤝 PASSATION OS\n\n— Tâches ouvertes —\n" + todos.strip()
            + "\n\n— Décisions récentes —\n" + decisions.strip()
            + "\n\n— Sprints actifs —\n" + sprints.strip())


def _os_regen_memory_index(mem_dir):
    """Port verbatim de intentions_server.py::_regen_memory_index (best-effort, ne lève jamais)."""
    import time as _time
    try:
        entries = []
        for fname in sorted(os.listdir(mem_dir)):
            fpath = os.path.join(mem_dir, fname)
            if fname == "MEMORY.md" or not fname.endswith(".md") or not os.path.isfile(fpath):
                continue
            desc = fname[:-3]
            try:
                with open(fpath, "r", encoding="utf-8") as f:
                    head = f.read(2000)
                for line in head.splitlines():
                    if line.startswith("description:"):
                        desc = line.split(":", 1)[1].strip()
                        break
            except OSError:
                pass
            entries.append(f"- [{fname[:-3]}]({fname}) — {desc}")
        journal_dir = os.path.join(mem_dir, "journal")
        if os.path.isdir(journal_dir):
            for fname in sorted(os.listdir(journal_dir)):
                if fname.endswith(".md"):
                    entries.append(f"- [{fname[:-3]}](journal/{fname})")
        body = (
            "# MEMORY INDEX (auto-généré)\n\n"
            f"_Mis à jour : {_time.strftime('%Y-%m-%d %H:%M UTC', _time.gmtime())}_\n\n"
            + "\n".join(entries) + "\n"
        )
        with open(os.path.join(mem_dir, "MEMORY.md"), "w", encoding="utf-8") as f:
            f.write(body)
    except OSError:
        pass


def _os_session_close(args):
    """Port verbatim de intentions_server.py::_write_session_close, généralisé à
    l'agent appelant (_OS_SELF_ID = UBIK_AGENT_ID) au lieu de Pilot OS uniquement."""
    import time as _time
    mem_dir = os.path.join(_OS_MEMORY_ROOT, "agents", _OS_SELF_ID, "memory")
    journal_dir = os.path.join(mem_dir, "journal")
    try:
        os.makedirs(journal_dir, exist_ok=True)
    except OSError as exc:
        return f"[error] os_session_close: échec création espace mémoire ({exc})"

    todos = _os_todos_text()
    decisions = _os_decisions_text(5)
    sprints = _os_sprints_text()
    today = _time.strftime("%Y-%m-%d")
    now = _time.strftime("%Y-%m-%d %H:%M UTC", _time.gmtime())

    handoff_body = (
        f"---\nname: handoff\ndescription: Clôture OS — {today}\n"
        f"metadata:\n  type: handoff\n---\n\n"
        f"# Handoff — ({_OS_SELF_ID})\n\n"
        f"> Clôture automatique · {now}\n\n"
        f"## Tâches ouvertes\n{todos.strip()}\n\n"
        f"## Décisions récentes\n{decisions.strip()}\n\n"
        f"## Sprints actifs\n{sprints.strip()}\n"
    )
    handoff_path = os.path.join(mem_dir, "handoff.md")
    try:
        with open(handoff_path, "w", encoding="utf-8") as f:
            f.write(handoff_body)
    except OSError as exc:
        return f"[error] os_session_close: échec écriture handoff.md ({exc})"

    journal_entry = (
        f"# Clôture — {now}\n\n"
        f"## Tâches ouvertes\n{todos.strip()}\n\n"
        f"## Décisions récentes\n{decisions.strip()}\n\n"
        f"## Sprints actifs\n{sprints.strip()}\n"
    )
    journal_path = os.path.join(journal_dir, f"{today}.md")
    try:
        if os.path.isfile(journal_path):
            with open(journal_path, "a", encoding="utf-8") as f:
                f.write("\n---\n\n" + journal_entry)
        else:
            with open(journal_path, "w", encoding="utf-8") as f:
                f.write(journal_entry)
    except OSError as exc:
        return f"[error] os_session_close: échec écriture journal ({exc})"

    _os_regen_memory_index(mem_dir)
    return f"Clôture écrite : {handoff_path} + {journal_path}."


def _os_admin_bus_register():
    try:
        _os_relay_http("POST", f"/admin/register/{_OS_SELF_ID}", {"label": _OS_SELF_ID})
    except Exception:
        pass


def _os_reboot_status(args):
    """Port verbatim de intentions_server.py::_await_restart_status (canal de
    vérité restart-status:{agent_id} côté console-meca), timeout raccourci (3s,
    comme l'appel os_reboot_status d'origine — outil de CONSULTATION, pas d'attente
    longue, contrairement à os_reboot_agent)."""
    import time as _time
    aid = str(args.get("agent_id", "")).strip()
    if not aid:
        return "[error] agent_id requis"
    timeout_s = 3.0
    _os_admin_bus_register()
    deadline = _time.time() + timeout_s
    last_seen = "unknown: no restart tracked for this agent"
    while True:
        try:
            _os_relay_http("POST", "/admin/send/console-meca",
                            {"from": _OS_SELF_ID, "message": f"restart-status:{aid}"})
        except Exception as e:
            return f"[error] échec envoi restart-status vers console-meca ({e})"
        remaining_total = deadline - _time.time()
        if remaining_total <= 0:
            break
        wait_s = max(0.5, min(3.0, remaining_total))
        try:
            r = _os_relay_http("GET", f"/admin/wait/{_OS_SELF_ID}?timeout={wait_s}", timeout=wait_s + 3.0)
        except Exception as e:
            return f"[error] échec lecture réponse console-meca ({e})"
        for m in (r.get("messages") or []):
            if m.get("from") == "console-meca":
                last_seen = (m.get("message") or "").strip() or last_seen
        if last_seen != "pending":
            break
        if _time.time() >= deadline:
            break
        _time.sleep(0.5)
    outcome = last_seen
    if outcome == "ok":
        return f"{aid} → reboot OK (confirmé par console-meca, restart-status)."
    if outcome.startswith("failed:"):
        return f"[error] {aid} → reboot ÉCHOUÉ (console-meca, restart-status) : {outcome}"
    if outcome == "pending":
        return f"{aid} → reboot EN COURS (console-meca : pending). Réessaie dans quelques secondes."
    if outcome == "unknown: no restart tracked for this agent":
        return (f"{aid} → AUCUN restart tracé par console-meca (jamais rebooté via "
                "agent-restart:, ou vehicle_id/slot invalide).")
    return f"[error] {aid} → statut console-meca : {outcome}"


def _os_peek(args):
    cmd = [os.path.join(_OS_BIN, "ubik-peek")]
    aid = (args.get("agent_id") or "").strip()
    if aid:
        cmd.append(aid)
        ln = args.get("lines")
        if isinstance(ln, int) and ln > 0:
            cmd.append(str(ln))
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=20.0)
        out = (p.stdout or "").strip() or (p.stderr or "").strip()
    except Exception as exc:
        return f"[error] échec ubik-peek : {exc}"
    # Filtrage secrets (audit OS-SEC-05) — recopié verbatim, ne JAMAIS exposer un
    # token/clé via le pane.
    out = re.sub(
        r"(?i)(token|password|passwd|secret|api[-_]?key|key|bearer|authorization)"
        r"([\"']?\s*[:=]\s*[\"']?)([^\s\"']{6,})",
        r"\1\2«redacted»", out,
    )
    return out or "(rien à afficher)"


def _os_activity(args):
    try:
        p = subprocess.run([os.path.join(_OS_BIN, "ubik-activity"), "agents"],
                           capture_output=True, text=True, timeout=20.0)
        out = (p.stdout or "").strip() or (p.stderr or "").strip()
    except Exception as exc:
        return f"[error] échec ubik-activity : {exc}"
    return out[:1500] or "(pas d'activité)"


def _os_read_doc(args):
    return _os_read_doc_or_list("os_read_doc", args)


def _os_list_docs(args):
    return _os_read_doc_or_list("os_list_docs", args)


def _os_read_doc_or_list(name, args):
    """Port verbatim de intentions_server.py (bloc os_read_doc/os_list_docs) —
    MÊME whitelist _OS_GIT_REPOS + MÊME validation anti-traversal (non négociable,
    validé Bertillon/Caton)."""
    repo = (args.get("repo") or "").strip()
    path = (args.get("path") or "").strip()
    ref = (args.get("ref") or "HEAD").strip()

    if not repo:
        return "[error] repo requis"
    if name == "os_read_doc" and not path:
        return "[error] path requis pour os_read_doc"

    repo_dir = _OS_GIT_REPOS.get(repo)
    if not repo_dir:
        avail = ", ".join(_OS_GIT_REPOS) or "(aucun)"
        return f"[error] Repo non autorisé : {repo!r}. Disponibles : {avail}"

    if not ref or " " in ref or "\n" in ref or "\r" in ref:
        return f"[error] ref invalide : {ref!r}"

    if path:
        if path.startswith("/"):
            return f"[error] chemin absolu interdit : {path!r}"
        parts = path.replace("\\", "/").split("/")
        if any(p == ".." for p in parts):
            return f"[error] traversal interdit : {path!r} contient '..'"

    if name == "os_read_doc":
        p = subprocess.run(["git", "-C", repo_dir, "show", f"{ref}:{path}"],
                           capture_output=True, text=True, timeout=10.0)
        if p.returncode != 0:
            err = p.stderr.strip()
            if any(k in err for k in ("does not exist", "exists on disk", "not in", "unknown revision")):
                return f"Fichier '{path}' introuvable dans {repo}@{ref}."
            return f"[error] Erreur git (os_read_doc) : {err[:200]}"
        content = p.stdout  # NE PAS .strip() : préserve le contenu Markdown

        range_arg = (args.get("range") or "").strip()
        if range_arg:
            lines_all = content.split("\n")
            try:
                if "-" in range_arg:
                    s, e = range_arg.split("-", 1)
                    s_i = max(0, int(s) - 1)
                    e_i = int(e)
                    content = "\n".join(lines_all[s_i:e_i])
                else:
                    content = "\n".join(lines_all[:int(range_arg)])
            except (ValueError, TypeError):
                pass

        if len(content) > _OS_MAX_DOC_CHARS:
            cut = content[:_OS_MAX_DOC_CHARS]
            last_nl = cut.rfind("\n")
            if last_nl > 0:
                cut = cut[:last_nl]
            content = cut + f"\n…[tronqué — {len(p.stdout)} chars au total ; utilise `range` pour lire la suite]"

        return content or f"(fichier vide : {repo}/{path}@{ref})"

    # os_list_docs
    cmd = ["git", "-C", repo_dir, "ls-tree", "--name-only", ref]
    if path:
        cmd.append(path if path.endswith("/") else path + "/")
    p = subprocess.run(cmd, capture_output=True, text=True, timeout=10.0)
    if p.returncode != 0:
        err = p.stderr.strip()
        if "not a tree object" in err or "unknown revision" in err:
            return f"Chemin/référence introuvable : {repo}@{ref}:{path or '(racine)'}."
        return f"[error] Erreur git (os_list_docs) : {err[:200]}"
    entries = [e for e in p.stdout.strip().split("\n") if e]
    if not entries:
        return f"Aucune entrée dans {repo}@{ref}:{path or '(racine)'}."
    header = f"Arborescence {repo}@{ref}:{path or '(racine)'} ({len(entries)} entrée(s)) :"
    body = "\n".join(f"  {e}" for e in entries[:200])
    suffix = f"\n  … +{len(entries) - 200} autres" if len(entries) > 200 else ""
    return f"{header}\n{body}{suffix}"


def _os_code_search(args):
    """Port verbatim de intentions_server.py (bloc os_code_search) — MÊME whitelist
    _OS_GIT_REPOS que os_read_doc/os_list_docs, PLUS le garde-fou anti-injection sur
    `ref` (RCE prouvée en sandbox via une option pager `-O` du sous-shell git grep —
    NON NÉGOCIABLE, ne pas simplifier cette validation)."""
    repo = (args.get("repo") or "").strip()
    pattern = (args.get("pattern") or "").strip()
    path = (args.get("path") or "").strip()
    ref = (args.get("ref") or "HEAD").strip()
    regex = bool(args.get("regex"))
    try:
        limit = int(args.get("limit") or 50)
    except (TypeError, ValueError):
        limit = 50
    limit = max(1, min(limit, 200))

    if not repo:
        return "[error] repo requis"
    if not pattern:
        return "[error] pattern requis pour os_code_search"

    repo_dir = _OS_GIT_REPOS.get(repo)
    if not repo_dir:
        avail = ", ".join(_OS_GIT_REPOS) or "(aucun)"
        return f"[error] Repo non autorisé : {repo!r}. Disponibles : {avail}"

    if not ref or " " in ref or "\n" in ref or "\r" in ref or ref.startswith("-"):
        return f"[error] ref invalide : {ref!r}"
    if path:
        if path.startswith("/"):
            return f"[error] chemin absolu interdit : {path!r}"
        parts = path.replace("\\", "/").split("/")
        if any(p == ".." for p in parts):
            return f"[error] traversal interdit : {path!r} contient '..'"

    cmd = ["git", "-C", repo_dir, "grep", "--color=never", "-n", "-I", "--full-name",
           "-E" if regex else "-F", "-e", pattern, ref]
    if path:
        cmd += ["--", path]
    p = subprocess.run(cmd, capture_output=True, text=True, timeout=15.0)

    if p.returncode == 1:
        loc = f"{repo}@{ref}" + (f":{path}" if path else "")
        return f"Aucun résultat pour {pattern!r} dans {loc}."
    if p.returncode not in (0, 1):
        err = p.stderr.strip()
        if any(k in err for k in ("unknown revision", "bad revision", "not a valid", "fatal: bad")):
            return f"Référence introuvable : {repo}@{ref}."
        return f"[error] Erreur git (os_code_search) : {err[:200]}"

    raw_lines = [l for l in p.stdout.split("\n") if l]
    total = len(raw_lines)
    shown = raw_lines[:limit]

    def _fmt(line):
        parts = line.split(":", 3)
        if len(parts) == 4:
            _r, fpath, lineno, text = parts
            return f"{fpath}:{lineno}: {text.strip()}"
        return line

    body = "\n".join(_fmt(l) for l in shown)
    loc = f"{repo}@{ref}" + (f":{path}" if path else "")
    header = f"{total} résultat(s) pour {pattern!r} dans {loc} :"
    suffix = (f"\n… +{total - limit} autre(s) résultat(s) (affine `pattern`/`path` "
              "ou augmente `limit`)") if total > limit else ""
    return f"{header}\n{body}{suffix}"


def _os_html_preview_open(args):
    path = (args.get("path") or "").strip()
    if not path:
        return "[error] path requis (chemin absolu d'un fichier .html/.htm local)"
    if not os.path.isabs(path):
        return f"[error] chemin absolu requis : {path!r}"
    if not path.lower().endswith((".html", ".htm")):
        return f"[error] extension .html/.htm requise, reçu : {path!r}"
    if not os.path.isfile(path):
        return f"[error] fichier introuvable : {path}"
    return (f"Artefact HTML validé : {os.path.basename(path)} — le panel de "
            "prévisualisation l'ouvre côté front (canal SSE).")


