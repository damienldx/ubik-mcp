#!/usr/bin/env python3
"""ubik — unified one-shot CLI router for the UBIK tool surface ("forge ring" in bash).

Mirrors the MCP gateway's namespace routing, but as a bash command with zero
context-token cost at rest. Each namespace forwards to the same backend the
MCP proxy uses, so behavior matches the gateway tool.

Usage:
    ubik <namespace> <tool> --args '<json-object>'   # invoke a tool
    ubik <namespace> --list                          # list tools (name + description)
    ubik <namespace> <tool> --schema                 # print a tool's JSON input schema
    ubik --namespaces                                # list available namespaces
"""
import argparse
import json
import os
import re
import subprocess
import sys
import urllib.request
import urllib.error

# Resolve install paths from the script's REAL location (robust under any HOME:
# fleet agents run with HOME=~/.fleet/<id>, where "~/workspace" resolves wrong).
REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))  # .../workspace/ubik-mcp
_REAL_HOME = os.path.dirname(os.path.dirname(REPO))                  # operator home

AGENT_BASE = os.environ.get("UBIK_BACKEND", "http://127.0.0.1:8765")
ENGINE_BASE = os.environ.get("UBIK_ENGINE_URL", "http://127.0.0.1:8801")
RELAY_BASE = os.environ.get("RELAY_URL", "http://127.0.0.1:7894")
ENGINE_SCHEMAS = os.environ.get(
    "UBIK_ENGINE_SCHEMAS",
    os.path.join(REPO, "data", "engine-bridge-schemas.json"),
)


def _agent_headers():
    """Replicate the MCP proxy identity headers so backend lead-only guards
    authorize CLI calls (x-ubik-caller-agent-id) — fleet agents set UBIK_AGENT_ID."""
    h = {}
    caller = os.environ.get("UBIK_AGENT_ID", "")
    if caller:
        h["x-ubik-caller-agent-id"] = caller
    try:
        cfg = json.load(open(os.path.join(_REAL_HOME, ".ubik-agent", "config.json")))
        if cfg.get("token"):
            h["x-ubik-agent-token"] = cfg["token"]
    except Exception:
        pass
    return h


def _http(method, url, body=None, timeout=60, headers=None):
    data = json.dumps(body).encode() if body is not None else None
    h = {"Content-Type": "application/json"}
    if headers:
        h.update(headers)
    req = urllib.request.Request(url, data=data, method=method, headers=h)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode()


# ---- agent namespace: proxy to UBIK backend :8765 (uniform execute endpoint) ----
def agent_list():
    d = json.loads(_http("GET", f"{AGENT_BASE}/api/tools/discover", timeout=10,
                         headers=_agent_headers()))
    return d if isinstance(d, list) else d.get("tools", d.get("result", []))


def agent_exec(tool, args):
    d = json.loads(_http("POST", f"{AGENT_BASE}/api/tools/execute",
                         {"tool": tool, "input": args}, headers=_agent_headers()))
    return d.get("result", d) if isinstance(d, dict) else d


# ---- engine namespace: proxy to ENGINE :8801 (uniform call endpoint) ----
def engine_list():
    return json.load(open(ENGINE_SCHEMAS, encoding="utf-8"))


def engine_exec(tool, args):
    d = json.loads(_http("POST", f"{ENGINE_BASE}/v1/tools/call",
                         {"name": tool, "args": args}))
    if isinstance(d, dict) and "result" in d:
        return d["result"]
    return d


# ---- generic stdio one-shot client: spawn the real MCP server, handshake, call ----
def _stdio_call(command, request, env_extra=None):
    """Spawn an MCP stdio server (`command` = argv list), do an initialize
    handshake, send `request` (id=2), return the matching JSON-RPC response.
    Runs the real server code => zero drift vs the gateway (same command).
    `env_extra` is an optional callable returning extra env vars (e.g. tokens)."""
    import subprocess, threading
    init = {"jsonrpc": "2.0", "id": 1, "method": "initialize",
            "params": {"protocolVersion": "2024-11-05", "capabilities": {},
                       "clientInfo": {"name": "ubik-cli", "version": "1"}}}
    inited = {"jsonrpc": "2.0", "method": "notifications/initialized"}
    payload = "\n".join(json.dumps(m) for m in (init, inited, request)) + "\n"
    # Match the gateway's runtime: use its nvm Node so tsx/node resolve identically
    # (avoids node-version drift in tool output) and inherit env (tokens come from
    # the caller's environment / per-server config, same as the gateway spawn).
    env = dict(os.environ)
    # Spawn operator-level MCP servers AS the operator: HOME drives python user-site
    # (the `mcp` module), npm/nvm, configs. Agent identity flows via UBIK_AGENT_ID env,
    # not HOME — so this is safe and fixes fleet-home spawns (HOME=~/.fleet/<id> lacks mcp).
    env["HOME"] = _REAL_HOME
    for node_bin in (os.path.join(_REAL_HOME, ".nvm/versions/node/v24.14.0/bin"),):
        if os.path.isdir(node_bin):
            env["PATH"] = node_bin + os.pathsep + env.get("PATH", "")
            break
    if env_extra:
        env.update(env_extra())
    # Client-driven lifecycle (do NOT use subprocess.run(input=...), which closes
    # stdin immediately): writing all messages then closing stdin makes the MCP
    # stdio server see EOF and tear down the session, which races the in-flight
    # request handler's response write. The server starts the call (its side
    # effect — e.g. a relay /send enqueue — fires) but the JSON-RPC reply is
    # dropped before flush → "no response" raised here ~10% of the time → the
    # caller double-sends an already-delivered DM. Repro'd 3/30; keeping stdin
    # open until the id=2 reply is read, then tearing down, is 0/30.
    proc = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, text=True, cwd=REPO, env=env)
    try:
        proc.stdin.write(payload)
        proc.stdin.flush()
    except (BrokenPipeError, ValueError):
        pass
    # Drain stderr concurrently so a chatty server (FastMCP logs each call) can't
    # fill the pipe and block the child before it answers.
    err_buf = []
    err_th = threading.Thread(target=lambda: err_buf.append(proc.stderr.read() or ""),
                              daemon=True)
    err_th.start()
    result = {"resp": None}
    def _read_resp():
        for line in proc.stdout:
            line = line.strip()
            if not line.startswith("{"):
                continue
            try:
                m = json.loads(line)
            except json.JSONDecodeError:
                continue
            if m.get("id") == 2:
                result["resp"] = m
                return
    read_th = threading.Thread(target=_read_resp, daemon=True)
    read_th.start()
    read_th.join(120)
    # Reply captured (or timed out): now it is safe to close stdin and stop the
    # server — the response write, if any, already happened.
    try:
        if proc.stdin and not proc.stdin.closed:
            proc.stdin.close()
        proc.terminate()
        proc.wait(timeout=5)
    except Exception:
        try:
            proc.kill()
        except Exception:
            pass
    if result["resp"] is not None:
        return result["resp"]
    err_th.join(2)
    err = ("".join(err_buf))[-300:]
    raise RuntimeError(f"no response from {command[-1]}; stderr={err}")


def _make_stdio(command, env_extra=None):
    def _list():
        r = _stdio_call(command, {"jsonrpc": "2.0", "id": 2, "method": "tools/list"}, env_extra)
        return r.get("result", {}).get("tools", [])

    def _exec(tool, args):
        r = _stdio_call(command, {"jsonrpc": "2.0", "id": 2, "method": "tools/call",
                                      "params": {"name": tool, "arguments": args}}, env_extra)
        res = r.get("result", {})
        txt = (res.get("content") or [{}])[0].get("text", "")
        if res.get("isError"):
            return f"[error] {txt}"
        try:
            return json.loads(txt)
        except (json.JSONDecodeError, TypeError):
            return txt

    return {"list": _list, "exec": _exec}


# Self-contained TS servers run one-shot via stdio (slower ~1.5s tsx startup, but
# infrequent + runs the real server code). Covers point 3 (TS) and point 4.
def _tsx(f):
    return ["npx", "-y", "tsx", f"src/servers/{f}"]

STDIO = {
    "github": _tsx("github.ts"), "linkedin": _tsx("linkedin.ts"), "review": _tsx("review.ts"),
    "system": _tsx("system.ts"), "lba": _tsx("lba.ts"),
    "skills": _tsx("skills.ts"), "crawl": _tsx("crawl.ts"),
    "google": _tsx("google.ts"), "microsoft": _tsx("microsoft.ts"),
    "whatsapp": _tsx("whatsapp.ts"),
    "lba-backend": _tsx("lba-backend.ts"),
    "relay": ["python3", os.path.join(_REAL_HOME, "workspace/ubik-fleet/fleet/starters/mcp_relay.py")],
    # workspace namespace (2026-06-20, politique CLI Damien): expose qubik_record_usage +
    # qubik_suggest (STEP-0 feedback/auto-equip) au CLI apres le drop du MCP ubik cote worker.
    # cold-spawn par appel (agent_workspace_* y figurent aussi, Docker = infrequent, OK).
    "workspace": ["python3", os.path.join(REPO, "agents-local", "workspace-server.py")],
}

# ---- memory namespace: in-process via the ubik_memory package (same dispatch as
# the `ubik-memory tool` CLI and the old memory.* MCP tools) ----
def memory_list():
    import asyncio
    from ubik_memory import mcp_server  # lazy: pulls duckdb only for `ubik memory`
    tools = asyncio.run(mcp_server.list_tools())
    return [{"name": t.name, "description": t.description or "",
             "inputSchema": getattr(t, "inputSchema", {}) or {}} for t in tools]


def memory_exec(tool, args):
    from ubik_memory import mcp_server  # lazy
    out = mcp_server.run_tool_text(tool, args)
    try:
        return json.loads(out)
    except (json.JSONDecodeError, TypeError):
        return out


NAMESPACES = {
    "memory": {"list": memory_list, "exec": memory_exec},
    "agent":  {"list": agent_list,  "exec": agent_exec},
    "engine": {"list": engine_list, "exec": engine_exec},
}
def _gh_token_env():
    """github.ts wants GITHUB_TOKEN; the gateway never wires it (REST tools 401).
    Reuse the already-authenticated gh CLI token — secret-safe, nothing stored."""
    import subprocess
    try:
        t = subprocess.run(["gh", "auth", "token"], capture_output=True, text=True, timeout=5).stdout.strip()
        return {"GITHUB_TOKEN": t} if t else {}
    except Exception:
        return {}

ENV_HOOKS = {"github": _gh_token_env}
for _n, _cmd in STDIO.items():
    NAMESPACES[_n] = _make_stdio(_cmd, ENV_HOOKS.get(_n))


# ---- relay namespace: mcp_relay.py exposes relay_send/relay_read/... over stdio,
# but NOT fleet_listen (the blocking long-poll). It lives in a separate MCP server
# (ubik-desktop-tools), so a CLI-only fleet home had no way to long-poll the inbox.
# Add it here as a direct HTTP GET to :7894/wait/<id>?timeout=N — leaner than
# spawning the stdio server for a hot-path long-poll (LEAD loops dispatch→listen).
_FLEET_LISTEN_SCHEMA = {
    "type": "object",
    "properties": {
        "agent_id": {"type": "string",
                     "description": "Agent whose inbox to long-poll (defaults to "
                                    "RELAY_AGENT_ID/UBIK_AGENT_ID env)."},
        "timeout": {"type": "integer", "default": 60,
                    "description": "Long-poll seconds, clamped to [1, 60]."},
    },
    "required": [],
}


def _relay_fleet_listen(args):
    """Block until a message is queued for agent_id (or timeout), then return the
    peeked inbox. Mirrors ubik-desktop-tools fleet_listen: GET /wait/<id>?timeout=N.
    Peeks without consuming — use `relay relay_read` to drain the queue."""
    agent_id = (args.get("agent_id")
                or os.environ.get("RELAY_AGENT_ID")
                or os.environ.get("UBIK_AGENT_ID", ""))
    if not agent_id:
        return "[error] fleet_listen requires agent_id (or RELAY_AGENT_ID/UBIK_AGENT_ID env)"
    try:
        timeout = int(args.get("timeout", 60))
    except (TypeError, ValueError):
        timeout = 60
    timeout = max(1, min(60, timeout))
    url = f"{RELAY_BASE}/wait/{agent_id}?timeout={timeout}"
    out = _http("GET", url, timeout=timeout + 5)
    try:
        return json.loads(out)
    except (json.JSONDecodeError, TypeError):
        return out


def _wrap_relay(base):
    def _list():
        tools = list(base["list"]())
        tools.append({"name": "fleet_listen",
                      "description": "Blocking long-poll of an agent's relay inbox "
                                     "(GET :7894/wait). Returns queued messages or "
                                     "empty after timeout. Peeks without consuming.",
                      "inputSchema": _FLEET_LISTEN_SCHEMA})
        return tools

    def _exec(tool, args):
        if tool == "fleet_listen":
            return _relay_fleet_listen(args)
        return base["exec"](tool, args)

    return {"list": _list, "exec": _exec}


NAMESPACES["relay"] = _wrap_relay(NAMESPACES["relay"])


# ---- workshop namespace: direct HTTP REST to UBIK backend :8765 ----
_WORKSHOP_TOOLS = [
    {"name": "list",
     "description": "List all workshops.",
     "inputSchema": {"type": "object", "properties": {}}},
    {"name": "show",
     "description": "Show a workshop by id.",
     "inputSchema": {"type": "object", "required": ["id"],
                     "properties": {"id": {"type": "string", "description": "Workshop id"}}}},
    {"name": "create",
     "description": "Create a new workshop (lead|operator only).",
     "inputSchema": {"type": "object", "required": ["name"],
                     "properties": {
                         "id":      {"type": "string", "description": "Optional stable id (e.g. ws-primus)"},
                         "name":    {"type": "string"},
                         "members": {"type": "array", "items": {"type": "string"}},
                         "lead":    {"type": "string"},
                     }}},
    {"name": "rename",
     "description": "Rename a workshop (lead|operator only).",
     "inputSchema": {"type": "object", "required": ["id", "name"],
                     "properties": {"id": {"type": "string"}, "name": {"type": "string"}}}},
    {"name": "lead-set",
     "description": "Set the lead of a workshop (lead|operator only).",
     "inputSchema": {"type": "object", "required": ["id", "lead"],
                     "properties": {"id": {"type": "string"}, "lead": {"type": "string"}}}},
    {"name": "member-add",
     "description": "Add a member to a workshop (lead|operator only).",
     "inputSchema": {"type": "object", "required": ["id", "member"],
                     "properties": {"id": {"type": "string"}, "member": {"type": "string"}}}},
    {"name": "member-remove",
     "description": "Remove a member from a workshop (lead|operator only).",
     "inputSchema": {"type": "object", "required": ["id", "member"],
                     "properties": {"id": {"type": "string"}, "member": {"type": "string"}}}},
    {"name": "dissolve",
     "description": "Dissolve (permanently delete) a workshop (lead|operator only).",
     "inputSchema": {"type": "object", "required": ["id"],
                     "properties": {"id": {"type": "string"}}}},
]


def _workshop_exec(tool, args):
    h = _agent_headers()
    ws_id = args.get("id", "")
    if tool == "list":
        out = _http("GET", f"{AGENT_BASE}/workshops", headers=h)
    elif tool == "show":
        out = _http("GET", f"{AGENT_BASE}/workshops/{ws_id}", headers=h)
    elif tool == "create":
        out = _http("POST", f"{AGENT_BASE}/workshops", args, headers=h)
    elif tool == "rename":
        out = _http("PATCH", f"{AGENT_BASE}/workshops/{ws_id}",
                    {"name": args.get("name")}, headers=h)
    elif tool == "lead-set":
        out = _http("PATCH", f"{AGENT_BASE}/workshops/{ws_id}",
                    {"lead": args.get("lead")}, headers=h)
    elif tool == "member-add":
        out = _http("PATCH", f"{AGENT_BASE}/workshops/{ws_id}",
                    {"member_add": args.get("member")}, headers=h)
    elif tool == "member-remove":
        out = _http("PATCH", f"{AGENT_BASE}/workshops/{ws_id}",
                    {"member_remove": args.get("member")}, headers=h)
    elif tool == "dissolve":
        out = _http("DELETE", f"{AGENT_BASE}/workshops/{ws_id}", headers=h)
    else:
        return f"[error] unknown workshop tool: {tool}"
    try:
        return json.loads(out)
    except (json.JSONDecodeError, TypeError):
        return out


NAMESPACES["workshop"] = {
    "list": lambda: _WORKSHOP_TOOLS,
    "exec": _workshop_exec,
}


# ---- docs namespace: DOCS DRIVE (KB de référence curée), REST vers backend :8765 ----
# Route vers l'API backend (et NON le module ubik_memory.docs_drive en local) :
# le backend tourne en HOME opérateur (systemd) donc tape le drive ~/.ubik-docs
# de l'opérateur. Un agent fleet shellant le module verrait son propre HOME de
# slot (drive vide) — prod-home-trap. Lecture = search/read/ls/tree/stats ;
# écriture/curation = mkdir/move/rename/ingest/rm.
_DOCS_TOOLS = [
    {"name": "stats", "description": "DOCS DRIVE: counts (files, chunks, embeddings).",
     "inputSchema": {"type": "object", "properties": {}}},
    {"name": "search", "description": "DOCS DRIVE: recherche sémantique dans la KB de référence.",
     "inputSchema": {"type": "object", "required": ["query"], "properties": {
         "query": {"type": "string"}, "limit": {"type": "integer", "description": "défaut 8"},
         "path_prefix": {"type": "string", "description": "limiter à un sous-dossier"}}}},
    {"name": "read", "description": "DOCS DRIVE: lit le contenu d'un document.",
     "inputSchema": {"type": "object", "required": ["path"], "properties": {
         "path": {"type": "string"}, "max_chars": {"type": "integer", "description": "défaut 20000"}}}},
    {"name": "ls", "description": "DOCS DRIVE: liste un dossier.",
     "inputSchema": {"type": "object", "properties": {"path": {"type": "string", "description": "défaut '.'"}}}},
    {"name": "tree", "description": "DOCS DRIVE: arborescence d'un dossier.",
     "inputSchema": {"type": "object", "properties": {
         "path": {"type": "string"}, "max_depth": {"type": "integer", "description": "défaut 3"}}}},
    {"name": "mkdir", "description": "DOCS DRIVE: crée un dossier (curation).",
     "inputSchema": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}}}},
    {"name": "move", "description": "DOCS DRIVE: déplace un fichier/dossier (curation).",
     "inputSchema": {"type": "object", "required": ["src", "dst"], "properties": {
         "src": {"type": "string"}, "dst": {"type": "string"}}}},
    {"name": "rename", "description": "DOCS DRIVE: renomme un fichier/dossier (curation).",
     "inputSchema": {"type": "object", "required": ["src", "new_name"], "properties": {
         "src": {"type": "string"}, "new_name": {"type": "string"}}}},
    {"name": "ingest", "description": "DOCS DRIVE: (ré)indexe un chemin (curation).",
     "inputSchema": {"type": "object", "properties": {
         "path": {"type": "string"}, "force": {"type": "boolean"}}}},
    {"name": "rm", "description": "DOCS DRIVE: supprime un fichier/dossier (curation).",
     "inputSchema": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}}}},
    {"name": "draft_create",
     "description": ("DOCS DRIVE: cree EN UN GESTE un draft narratif "
                      "_drafts/<repo>/<slug>.md (frontmatter status:draft/author/date "
                      "obligatoire, indexe immediatement) + la carte todo-board "
                      "'draft-curation' qui pointe dessus (LEAD curationne via le board "
                      "existant, pas de nouveau panel)."),
     "inputSchema": {"type": "object", "required": ["repo", "slug"], "properties": {
         "repo": {"type": "string", "description": "depot/module concerne (ex 'LBA-DESKTOP')."},
         "slug": {"type": "string", "description": "identifiant court du draft (ex 'sync-notes')."},
         "title": {"type": "string", "description": "titre lisible (defaut = slug)."},
         "content": {"type": "string", "description": "corps markdown initial (optionnel)."},
         "author": {"type": "string", "description": "defaut UBIK_AGENT_ID de l'appelant."},
         "tags": {"type": "array", "items": {"type": "string"},
                  "description": "tags additionnels sur la carte (draft-curation toujours ajoute)."}}}},
]


def _docs_exec(tool, args):
    from urllib.parse import urlencode
    h = _agent_headers()
    base = f"{AGENT_BASE}/api/docs"
    if tool == "stats":
        out = _http("GET", f"{base}/stats", headers=h)
    elif tool == "ls":
        out = _http("GET", f"{base}/ls?" + urlencode({"path": args.get("path", ".")}), headers=h)
    elif tool == "tree":
        out = _http("GET", f"{base}/tree?" + urlencode(
            {"path": args.get("path", "."), "max_depth": int(args.get("max_depth", 3))}), headers=h)
    elif tool == "read":
        out = _http("GET", f"{base}/read?" + urlencode(
            {"path": args.get("path", ""), "max_chars": int(args.get("max_chars", 20000))}), headers=h)
    elif tool == "search":
        out = _http("POST", f"{base}/search", {
            "query": args.get("query", ""), "limit": int(args.get("limit", 8)),
            "path_prefix": args.get("path_prefix")}, headers=h)
    elif tool == "mkdir":
        out = _http("POST", f"{base}/mkdir", {"path": args.get("path", "")}, headers=h)
    elif tool == "move":
        out = _http("POST", f"{base}/move", {"src": args.get("src", ""), "dst": args.get("dst", "")}, headers=h)
    elif tool == "rename":
        out = _http("POST", f"{base}/rename",
                    {"src": args.get("src", ""), "new_name": args.get("new_name", "")}, headers=h)
    elif tool == "ingest":
        body = {"force": bool(args.get("force"))}
        if args.get("path"):
            body["path"] = args["path"]
        out = _http("POST", f"{base}/ingest", body, headers=h)
    elif tool == "rm":
        out = _http("DELETE", f"{base}/rm?" + urlencode({"path": args.get("path", "")}), headers=h)
    elif tool == "draft_create":
        body = {
            "repo": args.get("repo", ""),
            "slug": args.get("slug", ""),
            "title": args.get("title"),
            "content": args.get("content", ""),
            "author": args.get("author") or os.environ.get("UBIK_AGENT_ID", ""),
            "tags": args.get("tags") or [],
        }
        out = _http("POST", f"{base}/draft_create", body, headers=h)
    else:
        return f"[error] unknown docs tool: {tool}"
    try:
        return json.loads(out)
    except (json.JSONDecodeError, TypeError):
        return out


NAMESPACES["docs"] = {
    "list": lambda: _DOCS_TOOLS,
    "exec": _docs_exec,
}


# ---- os namespace: Pilot OS — verbes MCP net-new portés en CLI (Cluster B, ------
# plan_b6e7b02a mission#2). Source de vérité : intentions_server.py::_execute_os
# (agent-12, /home/damienldx/.fleet/6da176c2-agent-12/), dispatcher unique v7
# post-Cluster-A. Portage MÉCANIQUE STRICT (dedup ledger l_24c95d0eee) : mêmes
# endpoints _http (relay :7894 / backend :8765), mêmes binaires sibling
# (ubik-peek, ubik-activity), mêmes garde-fous sécu recopiés verbatim
# (anti-traversal read_doc/list_docs, anti-injection ref code_search — RCE
# prouvée en sandbox sur `ref` non validé). Les 24 doublons purs identifiés à
# l'étape 1 NE SONT PAS ici : on utilise leur tool CLI existant directement
# (agent.dashboard_weather, memory.context_search, relay.relay_send, docs.*...).
# os_reboot_workshop reste HORS SCOPE (relayout destructif multi-étapes,
# décision LEAD) — reste MCP-only.
_OS_BIN = os.path.join(_REAL_HOME, ".local", "bin")
_OS_GIT_REPOS = {
    k: v for k, v in {
        "UBIK": os.environ.get("UBIK_REPO_PATH", os.path.join(_REAL_HOME, "workspace", "UBIK")),
        "LBA": os.environ.get("LBA_REPO_PATH", os.path.join(_REAL_HOME, "workspace", "LBA-DESKTOP")),
    }.items() if os.path.isdir(v)
}
_OS_MAX_DOC_CHARS = int(os.environ.get("JANUS_MAX_DOC_CHARS", "8000"))
# Identité "self" : généralisée à l'appelant CLI (UBIK_AGENT_ID), à la différence
# de intentions_server.py où _SELF_ID est Pilot OS uniquement (JANUS_FLEET_AGENT_ID).
_OS_SELF_ID = os.environ.get("UBIK_AGENT_ID", "").strip() or "pilotos-agent-0"
_OS_MEMORY_ROOT = os.environ.get("UBIK_MEMORY_ROOT", os.path.join(_REAL_HOME, ".ubik-memory"))


def _os_relay_http(method, path, payload=None, timeout=8.0):
    out = _http(method, RELAY_BASE.rstrip("/") + path, body=payload, timeout=timeout,
               headers={"Content-Type": "application/json"} if payload else None)
    return json.loads(out) if out else {}


def _os_backend_http(method, path, payload=None, timeout=8.0):
    out = _http(method, AGENT_BASE.rstrip("/") + path, body=payload, timeout=timeout,
               headers=_agent_headers())
    return json.loads(out) if out else {}


def _os_classify_error(exc):
    """Même classification que intentions_server.py::_classify_error (audit OS-SEC error_type)."""
    import socket
    if isinstance(exc, urllib.error.HTTPError):
        return "not-found" if exc.code == 404 else f"http-{exc.code}"
    if isinstance(exc, (TimeoutError, socket.timeout, subprocess.TimeoutExpired)):
        return "timeout"
    if isinstance(exc, urllib.error.URLError):
        return "service-down"
    if isinstance(exc, ConnectionError):
        return "service-down"
    return "error"


def _os_dashboard_text():
    out = agent_exec("dashboard_weather", {})
    return out if isinstance(out, str) else json.dumps(out, ensure_ascii=False, indent=2)


def _os_sprints_text():
    d = agent_exec("project_list", {})
    projs = d.get("projects", []) if isinstance(d, dict) else []
    if not projs:
        return "Aucun projet/sprint dans l'atelier."
    lines = ["Sprints / projets :"]
    for p in projs[:12]:
        lines.append(f"  • {p.get('name', '?')} — {p.get('status', '?')} ({p.get('fork_count', 0)} forks)")
    return "\n".join(lines)


def _os_decisions_text(limit=5):
    d = agent_exec("ledger_query", {"limit": limit})
    items = []
    if isinstance(d, dict):
        items = d.get("entries") or d.get("ledger") or d.get("results") or d.get("rows") or []
    if not items:
        return "Aucune décision récente au ledger."
    import datetime as _dt
    lines = ["Dernières décisions (ledger) :"]
    for e in items[:limit]:
        ts = e.get("at") or e.get("ts") or ""
        if isinstance(ts, (int, float)):
            try:
                ts = _dt.datetime.fromtimestamp(ts, _dt.timezone.utc).strftime("%Y-%m-%d %H:%M")
            except Exception:
                ts = str(ts)
        ts = str(ts)[:16]
        act = e.get("action") or e.get("rationale") or ""
        lines.append(f"  • [{ts}] {e.get('actor', '?')}: {str(act)[:160]}")
    return "\n".join(lines)


def _os_inbox_text(limit=5):
    payload = {"to_agent": _OS_SELF_ID, "limit": limit, "query": "message récent"}
    d = memory_exec("context_dm_search", payload)
    dms = []
    if isinstance(d, dict):
        dms = d.get("dms") or d.get("matches") or d.get("results") or []
    if not dms:
        return "Boîte de réception vide (aucun DM récent)."
    lines = ["DM récents :"]
    for m in dms[:limit]:
        ts = (m.get("ts") or m.get("at") or "")[:16]
        frm = m.get("from_agent") or m.get("from") or "?"
        txt = (m.get("snippet") or m.get("message") or m.get("text") or "").replace("\n", " ")
        lines.append(f"  • [{ts}] {frm}: {txt[:160]}")
    return "\n".join(lines)


def _os_todos_text():
    """Helper interne (os_todos lui-même est hors-scope Cluster B — géré ailleurs/
    MCP-only) : reproduit UNIQUEMENT le comportement par défaut (board ouvert,
    sans filtre) nécessaire à os_handoff."""
    d = agent_exec("todo_list", {})
    todos = []
    if isinstance(d, dict):
        todos = d.get("todos") or d.get("items") or d.get("results") or []
    todos = [t for t in todos if t.get("status") != "done"]
    if not todos:
        return "Aucune tâche ouverte."
    lines = [f"Tableau de mission ({len(todos)} ouvertes) :"]
    for t in todos[:25]:
        pr = t.get("priority") or t.get("prio") or ""
        st = t.get("status", "?")
        title = t.get("title") or t.get("subject") or "?"
        asg = t.get("assignee") or ""
        suffix = f" → {asg}" if asg else ""
        tid = t.get("id") or "?"
        lines.append(f"  • [{tid}] [{st}{('/' + pr) if pr else ''}] {title[:90]}{suffix}")
    if len(todos) > 25:
        lines.append(f"  … +{len(todos) - 25} autres")
    return "\n".join(lines)


def _os_thread_status(args):
    d = _os_backend_http("GET", "/api/threads/context")
    ags = d.get("agents", [])
    if not ags:
        return "Aucun agent avec contexte mesuré pour l'instant."
    lines = ["Contexte par agent (fill %) :"]
    for a in ags:
        lines.append(f"  {a.get('label', '?')} — {a.get('pct', 0)}% ({a.get('model', '?')})")
    return "\n".join(lines)


def _os_quota_status(args):
    d = _os_backend_http("GET", "/api/quota/cycles")
    w = d.get("window_week", {})
    h = d.get("window_5h", {})
    rep = d.get("representative_claim", "?")
    stale = " [STALE]" if d.get("stale") else ""
    w_pct = round((w.get("utilization") or 0) * 100)
    h_pct = round((h.get("utilization") or 0) * 100)
    return "\n".join([
        f"QUOTA{stale}",
        f"  Hebdo : {w_pct}% utilisé — remaining={w.get('remaining', '?')} — reset {w.get('reset_at', '?')} — {w.get('status', '?')}",
        f"  5h    : {h_pct}% utilisé — reset {h.get('reset_at', '?')}",
        f"  claim : {rep}",
    ])


def _os_agent_detail(args):
    aid = str(args.get("agent_id", "")).strip()
    if not aid:
        return "[error] agent_id requis"
    agents = _os_relay_http("GET", "/agents")
    a = agents.get(aid) if isinstance(agents, dict) else None
    if not a:
        return f"Agent {aid} introuvable dans le relay."
    return (f"{a.get('label', aid)} ({aid}) — pending={a.get('pending', 0)} · "
            f"caps={a.get('capabilities')} · vu {a.get('last_seen', '?')} · "
            f"tmux={a.get('tmux_target') or '—'}")


def _os_self_context(args):
    d = _os_backend_http("GET", "/api/threads/context")
    me = next((a for a in d.get("agents", []) if a.get("agent") == _OS_SELF_ID), None)
    if not me:
        return ("Mon contexte n'est pas encore mesuré (pas de tour usage-bearing dans le "
                 "transcript). Réessaie après quelques échanges.")
    pct = me.get("pct", 0)
    cache = me.get("cache_pct", 0)
    model = me.get("model", "?")
    if pct >= 85:
        verdict = "⚠ COMPACTION PROCHE — écris ton handoff / passe la main MAINTENANT."
    elif pct >= 70:
        verdict = "⚠ ~70% — prépare ton handoff."
    else:
        verdict = "✅ OK — marge confortable."
    return f"Mon contexte ({model}) : {pct}% rempli · cache {cache}%. {verdict}"


def _os_check_connectivity(args):
    lines = ["Connectivité des briques OS :"]
    for label, base in (("relay (:7894)", RELAY_BASE), ("backend (:8765)", AGENT_BASE)):
        try:
            _http("GET", base.rstrip("/") + "/health", timeout=4)
            lines.append(f"  ✅ {label} — up")
        except Exception as exc:
            lines.append(f"  ❌ {label} — DOWN [{_os_classify_error(exc)}]")
    return "\n".join(lines)


