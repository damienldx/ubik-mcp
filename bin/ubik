    return _os_dashboard_text()


def _os_sprints(args):
    return _os_sprints_text()


def _os_decisions(args):
    limit = args.get("limit") if isinstance(args.get("limit"), int) else 5
    return _os_decisions_text(limit)


def _os_inbox(args):
    limit = args.get("limit") if isinstance(args.get("limit"), int) else 5
    q = (args.get("query") or "").strip()
    payload = {"to_agent": _OS_SELF_ID, "limit": limit, "query": q or "message récent"}
    d = memory_exec("context_dm_search", payload)
    dms = []
    if isinstance(d, dict):
        dms = d.get("dms") or d.get("matches") or d.get("results") or []
    if not dms:
        return "Boîte de réception vide (aucun DM récent)."
    lines = ["DM récents :"]
    for m in dms[:limit]:
        ts = (m.get("ts") or m.get("at") or "")[:16]
        frm = m.get("from_agent") or m.get("from") or "?"
        txt = (m.get("snippet") or m.get("message") or m.get("text") or "").replace("\n", " ")
        lines.append(f"  • [{ts}] {frm}: {txt[:160]}")
    return "\n".join(lines)


def _os_todos(args):
    status = (args.get("status") or "").strip()
    assignee = (args.get("assignee") or "").strip()
    tag = (args.get("tag") or "").strip()
    sort_by = (args.get("sort_by") or "").strip()
    search = (args.get("search") or "").strip()
    tool_args = {}
    if status:
        tool_args["status"] = status
    if assignee:
        tool_args["assignee"] = assignee
    if tag:
        tool_args["tag"] = tag
    if sort_by:
        tool_args["sort_by"] = sort_by
    if search:
        tool_args["search"] = search
    d = agent_exec("todo_list", tool_args)
    if isinstance(d, dict) and not d.get("ok", True) and d.get("error"):
        return f"[error] Échec lecture board : {d['error']}"
    todos = d.get("todos") or d.get("items") or d.get("results") or [] if isinstance(d, dict) else []
    if not status:
        todos = [t for t in todos if t.get("status") != "done"]
    total = len(todos)
    try:
        limit = int(args.get("limit")) if args.get("limit") is not None else 25
    except (TypeError, ValueError):
        limit = 25
    limit = max(1, min(limit, 200))
    try:
        offset = int(args.get("offset")) if args.get("offset") is not None else 0
    except (TypeError, ValueError):
        offset = 0
    offset = max(0, offset)
    page = todos[offset:offset + limit]
    if not page:
        return ("Aucune tâche ouverte." if not (status or assignee or tag or search)
                else "Aucune tâche pour ces filtres.")
    filt = " · ".join(
        x for x in [status, (f"→{assignee}" if assignee else ""), (f"#{tag}" if tag else ""),
                    (f"\"{search}\"" if search else ""), (f"tri:{sort_by}" if sort_by else "")]
        if x
    ) or "ouvertes"
    hdr = f"Tableau de mission ({total} {filt}"
    hdr += f", page {offset}-{offset + len(page)}" if total > len(page) or offset else ""
    lines = [hdr + ") :"]
    for t in page:
        pr = t.get("priority") or t.get("prio") or ""
        st = t.get("status", "?")
        title = t.get("title") or t.get("subject") or "?"
        asg = t.get("assignee") or ""
        suffix = f" → {asg}" if asg else ""
        tid = t.get("id") or "?"
        created = (t.get("created_at") or "")[:10]
        updated = (t.get("updated_at") or "")[:10]
        dates = f" (créé:{created} maj:{updated})" if created or updated else ""
        lines.append(f"  • [{tid}] [{st}{('/' + pr) if pr else ''}] {title[:90]}{suffix}{dates}")
    if offset + len(page) < total:
        lines.append(f"  … +{total - offset - len(page)} autres (offset={offset + len(page)} pour la suite).")
    return "\n".join(lines)


def _os_todo_get(args):
    tid = (args.get("id") or "").strip()
    if not tid:
        return "[error] id requis"
    d = agent_exec("todo_list", {})
    todos = d.get("todos") or [] if isinstance(d, dict) else []
    t = next((x for x in todos if x.get("id") == tid), None)
    if not t:
        return f"Carte '{tid}' introuvable."
    lines = [f"Carte {t.get('id')} — {t.get('title', '?')}",
             f"  statut   : {t.get('status', '?')}  ·  priorité : {t.get('priority', '?')}",
             f"  assignee : {t.get('assignee') or '(non assignée)'}",
             f"  tags     : {', '.join(t.get('tags') or []) or '(aucun)'}",
             f"  créée par: {t.get('created_by', '?')}  ·  maj : {(t.get('updated_at') or '')[:19]}"]
    if t.get("brief"):
        lines.append(f"  brief    : {str(t['brief'])[:500]}")
    if t.get("link"):
        lines.append(f"  lien     : {json.dumps(t['link'], ensure_ascii=False)}")
    cmts = t.get("comments") or []
    if cmts:
        lines.append(f"  commentaires ({len(cmts)}) :")
        for c in cmts[-5:]:
            lines.append(f"    • [{(c.get('at') or '')[:16]}] {c.get('author', '?')}: {str(c.get('text', ''))[:140]}")
    return "\n".join(lines)


