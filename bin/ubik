    {"name": "os_save_layout",
     "description": "Sauvegarde la disposition courante des panels sous un nom. HTTP direct, PAS un relay SSE.",
     "inputSchema": {"type": "object", "required": ["name"],
                     "properties": {"name": {"type": "string", "description": "Nom du layout à sauvegarder."}}}},
