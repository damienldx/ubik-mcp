    msg = (args.get("message") or "").strip()
    if not cid or not msg:
        return "[error] channel_id et message requis"
    _os_relay_http("POST", f"/send/channel:{cid}", {"from": _OS_SELF_ID, "message": msg})
    return f"Message posté sur le canal '{cid}'."


def _os_channel_read(args):
    cid = str(args.get("channel_id", "")).strip()
    if not cid:
        return "[error] channel_id requis"
    limit = args.get("limit") if isinstance(args.get("limit"), int) else 10
    items = _os_relay_http("GET", f"/radio?channel=channel:{cid}&limit={limit}")
    if not isinstance(items, list) or not items:
        return f"Canal '{cid}' : aucun message."
    lines = [f"Canal '{cid}' ({len(items)} messages) :"]
    for m in items[:limit]:
        ts = (m.get("at") or "")[:16]
        frm = m.get("from_label") or m.get("from") or "?"
        txt = (m.get("message") or m.get("text") or "").replace("\n", " ")
        lines.append(f"  • [{ts}] {frm}: {txt[:140]}")
    return "\n".join(lines)


