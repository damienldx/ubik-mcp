# Portage mécanique des tools _OS_TOOLS restants — exécution DIRECTE via
# _execute_os() côté serveur (kit/janus-home/intentions_server.py, slot
# 6da176c2-agent-12), ZÉRO dépendance SSE, contrairement au relay Cluster C.
# Audit source : ledger l_4b598c0160 (Palladio). Wrap 1:1 du comportement
# réel (mêmes endpoints/mêmes tools `ubik agent`/`ubik memory` sous-jacents).

def _os_fleet_state(args):
    agents = _os_relay_http("GET", "/agents")
    vehicles = _os_relay_http("GET", "/vehicles")
    lines = ["AGENTS :"]
    for aid, a in sorted((agents or {}).items()):
        lines.append(f"  {a.get('label', aid)} ({aid}) — pending={a.get('pending', 0)} — vu {a.get('last_seen', '?')}")
    lines.append("VÉHICULES :")
    vobj = vehicles if isinstance(vehicles, dict) else {}
    for vid, v in vobj.items():
        nm = v.get("name", vid) if isinstance(v, dict) else str(v)
        lines.append(f"  {vid} — {nm}")
    return "\n".join(lines)


def _os_recall(args):
    q = (args.get("query") or "").strip()
    if not q:
        return "[error] query requis"
    limit = args.get("limit") if isinstance(args.get("limit"), int) else 5
    operator = (args.get("operator") or "").strip().upper()
    if operator in ("AND", "OR"):
        terms = [t for t in q.split() if t]
        d = memory_exec("context_multi_search", {"queries": terms, "operator": operator})
    else:
        d = memory_exec("context_search", {"query": q, "limit": limit})
    matches = d.get("matches", []) if isinstance(d, dict) else []
    if not matches:
        return f"Aucun souvenir trouvé pour « {q} »."
    lines = [f"Mémoire OS — « {q} » ({len(matches)} résultats) :"]
    for m in matches[:limit]:
        ts = (m.get("ts") or "")[:16]
        snip = (m.get("snippet") or m.get("text") or "").strip().replace("\n", " ")
        src = m.get("from_agent") or m.get("host") or m.get("kind") or ""
        lines.append(f"  • [{ts}] {src}: {snip[:160]}")
    return "\n".join(lines)


_PROJECT_NAME_RE = re.compile(r"^[A-Za-z0-9_-]+$")


def _os_memory_save(args):
    content = (args.get("content") or "").strip()
    if not content:
        return "[error] content requis"
    mtype = (args.get("type") or "").strip()
    project = (args.get("project") or "").strip()
    if project and not _PROJECT_NAME_RE.match(project):
        return f"[error] Nom de projet invalide : {project!r}."
    payload = {"content": content}
    if mtype:
        payload["type"] = mtype
    if project:
        payload["project"] = project
    d = memory_exec("memory_save", payload)
    if isinstance(d, dict) and d.get("ok") is False:
        return f"[error] Échec sauvegarde mémoire : {d.get('error', d)}"
    dest = (d.get("path") or d.get("file")) if isinstance(d, dict) else None
    return f"Mémoire enregistrée ({dest or project or mtype or 'decisions'})."


def _os_ledger_record(args):
    source = (args.get("source") or "").strip()
    action = (args.get("action") or "").strip()
    if not source or not action:
        return "[error] source (str) et action (str) requis"
    role = (args.get("role") or "event").strip()
    if role not in ("setup", "event", "turn", "resolution"):
        role = "event"
    actor = (args.get("actor") or "").strip() or _OS_SELF_ID
    rationale = (args.get("rationale") or "").strip()
    tags = args.get("tags")
    payload = {"source": source, "action": action, "actor": actor, "role": role}
    if rationale:
        payload["rationale"] = rationale
    if isinstance(tags, list) and tags:
        payload["tags"] = [str(t) for t in tags]
    d = agent_exec("ledger_record", payload)
    if isinstance(d, dict) and d.get("ok") is False:
        return f"[error] Échec enregistrement ledger : {d.get('error', d)}"
    entry = d.get("entry") or {} if isinstance(d, dict) else {}
    eid = entry.get("id") or "?"
    warn = (" (rationale <20 car., tagué short-rationale)"
            if role in ("turn", "resolution") and len(rationale) < 20 else "")
    return f"Décision tracée au ledger ({eid}){warn}."


