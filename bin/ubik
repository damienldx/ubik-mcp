_OS_AGENT_ID_RE = re.compile(r"^[a-zA-Z0-9][\w:-]{1,63}$")
_OS_PRIMUS_ID = os.environ.get("UBIK_LEAD_ID", "6da176c2-agent-0")


def _os_vehicle_of(agent_id):
    if not agent_id or "-agent-" not in agent_id:
        return None
    return agent_id.split("-agent-", 1)[0] or None


def _os_read_lead(vehicle_id):
    try:
        with open("/home/damienldx/.ubik-memory/lead.json") as f:
            data = json.load(f)
    except Exception:
        return None
    if not isinstance(data, dict):
        return None
    vmap = data.get("vehicles")
    if isinstance(vmap, dict):
        return vmap.get(vehicle_id)
    legacy = data.get("agent_id")
    return legacy if _os_vehicle_of(legacy) == vehicle_id else None


def _os_lead_for(agent_id):
    vid = _os_vehicle_of(agent_id)
    return _os_read_lead(vid) if vid else None


def _os_dm(args):
    to = str(args.get("to", "")).strip()
    msg = (args.get("message") or "").strip()
    if not to or not msg:
        return "[error] to et message requis"
    if not _OS_AGENT_ID_RE.match(to):
        return f"[error] Destinataire invalide : {to!r}. Attendu un agent_id fleet (ex: 6da176c2-agent-7)."
    _os_relay_http("POST", f"/send/{to}", {"from": _OS_SELF_ID, "message": msg})
    if to == _os_lead_for(to):
        if to == _OS_PRIMUS_ID:
            return ("Passé à Lord Primus (arbitrage cross-fleet / périmètre dev). MAINTENANT, "
                    "réponds au demandeur en UNE phrase claire : « Ça relève de l'arbitrage "
                    "cross-fleet, je passe la main à Lord Primus. »")
        return (f"Coordonné en direct (lead↔lead) avec {to}, lead du véhicule "
                f"{_os_vehicle_of(to)}. MAINTENANT, réponds au demandeur en UNE phrase claire : "
                f"« Je coordonne ça directement avec le lead concerné ({to}). »")
    return f"Message envoyé à {to}."


