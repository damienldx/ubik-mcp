def _os_exec(tool, args):
    handler = (_OS_HANDLERS_B.get(tool) or _OS_HANDLERS_C.get(tool)
               or _OS_HANDLERS_D.get(tool) or _OS_HANDLERS_E.get(tool)
               or _OS_HANDLERS_F.get(tool))
    if handler is None:
        return f"[error] unknown os tool: {tool}"
    return handler(args)


NAMESPACES["os"] = {
    "list": lambda: _OS_TOOLS_B + _OS_TOOLS_C + _OS_TOOLS_D + _OS_TOOLS_E + _OS_TOOLS_F,
    "exec": _os_exec,
}


