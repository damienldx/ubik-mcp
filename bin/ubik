def _os_daily_digest(args):
    import time as _time
    date = (args.get("date") or "").strip() or _time.strftime("%Y-%m-%d")
    d = memory_exec("context_daily_digest", {"date": date})
    if not isinstance(d, dict):
        return str(d)[:1200] or f"Rien pour {date}."
    s = d.get("sessions", {})
    lg = d.get("ledger", {})
    dm = d.get("dms", {})
    forks = d.get("forks_delivered", [])
    lines = [f"Journée {date} :",
             f"  • {s.get('count', 0)} sessions ({s.get('total_duration', '?')}, "
             f"{s.get('total_messages', 0)} messages)",
             f"  • {lg.get('total', 0)} décisions au ledger",
             f"  • {dm.get('count', 0)} DM ({dm.get('unique_senders', 0)} émetteurs)",
             f"  • {len(forks)} forks livrés"]
    tops = lg.get("top_actions") or []
    if tops:
        lines.append("  Top décisions : " + ", ".join(
            str(t.get("action", t) if isinstance(t, dict) else t)[:50] for t in tops[:3]))
    return "\n".join(lines)


