def _emit(value):
    if isinstance(value, (dict, list)):
        sys.stdout.write(json.dumps(value, ensure_ascii=False, indent=2) + "\n")
    else:
        sys.stdout.write(str(value) + "\n")


def _is_applicative_failure(value):
    """Exit contract (t_129e4dbdf7): the wrapper must exit non-zero when the
    backend reports an applicative error, so shell `&&` patterns stop lying.
    Failure = top-level {ok:false} or {status>=400} (backend :8765 convention),
    or an "[error] ..." string (stdio isError path, fleet_listen misuse).
    Anything else — including plain-text "ok" from relay_send — is success."""
    if isinstance(value, dict):
        if value.get("ok") is False:
            return True
        status = value.get("status")
        if isinstance(status, int) and status >= 400:
            return True
    return isinstance(value, str) and value.startswith("[error]")


def _err(msg, code):
    sys.stderr.write(json.dumps({"error": msg}) + "\n")
    raise SystemExit(code)


_ATELIER_STATE = os.path.join(_REAL_HOME, ".ubik-state", "atelier", "state.json")


def _dispatch_500_fallback(args):
    """After a 500 from atelier_dispatch_mission, read state.json to distinguish
    a phantom 500 (state already saved) from a real failure (mission still pending)."""
    plan_id = args.get("plan_id", "")
    mission_n = args.get("mission_n")
    try:
        state = json.loads(open(_ATELIER_STATE).read())
        missions = state.get("plans", {}).get(plan_id, {}).get("missions", [])
        mission = next((m for m in missions if m.get("n") == mission_n), None)
        status = mission.get("status") if mission else None
        if status == "dispatched":
            sys.stderr.write(
                "⚠ Mission déjà dispatched (state sauvegardé) — relay send raté. "
                "Envoie le brief manuellement via relay_send.\n"
            )
        else:
            sys.stderr.write(
                f"✗ 500 réel — mission toujours {status or 'pending/introuvable'}. "
                "Escalade LEAD immédiatement.\n"
            )
    except Exception as exc:
        sys.stderr.write(f"[fallback] impossible de lire state.json : {exc}\n")


# Tools de l'équipement (STEP-0) à NE PAS créditer comme "tool utilisé pour la
# tâche" : ce sont des meta-tools de découverte/adoption, pas l'exécution.
_AUTOCLOSE_SKIP = {
    "qubik_suggest", "qubik_record_usage",
    "skills_recall", "skills_search", "agent_search",
}


def _maybe_autoclose(tool, result):
    """Ferme la boucle du feedback qubik au moment de l'usage réel d'un tool.

    Best-effort, non-bloquant, fail-safe : POST fire-and-forget à l'ENGINE qui
    marque le qubik_suggest récent non bouclé de cet agent avec CE tool. Comble le
    48% d'agents qui sautent l'étape [4] — sans dépendre de leur discipline, avec
    le vrai nom du tool (robuste au CLI-first). N'ajoute jamais d'échec à l'appel.
    """
    agent = os.environ.get("UBIK_AGENT_ID", "").strip()
    if not agent or tool in _AUTOCLOSE_SKIP:
        return
    if _is_applicative_failure(result):
        return  # ne pas créditer un tool qui a échoué
    try:
        body = json.dumps({"agent_id": agent, "tool": tool, "window_min": 5}).encode()
        req = urllib.request.Request(
            f"{ENGINE_BASE}/v1/qubik/autoclose",
            data=body, headers={"Content-Type": "application/json"}, method="POST",
        )
        urllib.request.urlopen(req, timeout=1.5).read()
    except Exception:
        pass  # jamais bloquer ni casser l'appel réel


def main():
    p = argparse.ArgumentParser(prog="ubik", description="Unified one-shot CLI for the UBIK tool surface")
    p.add_argument("namespace", nargs="?", help="e.g. agent, engine")
    p.add_argument("tool", nargs="?", help="tool name (omit with --list)")
    p.add_argument("--args", default="{}", help="JSON object of tool arguments")
    p.add_argument("--list", action="store_true", help="List tools in the namespace")
    p.add_argument("--schema", action="store_true", help="Print the JSON input schema for <tool>")
    p.add_argument("--namespaces", action="store_true", help="List available namespaces")
    a = p.parse_args()

    if a.namespaces or not a.namespace:
        _emit(sorted(NAMESPACES))
        return

    ns = NAMESPACES.get(a.namespace)
    if ns is None:
        _err(f"unknown namespace: {a.namespace} (have: {', '.join(sorted(NAMESPACES))})", 2)

    if a.list:
        tools = ns["list"]()
        _emit([{"name": t.get("name"),
                "description": (t.get("description") or "").strip().splitlines()[0]
                               if (t.get("description") or "").strip() else ""}
               for t in tools])
        return

    if a.schema:
        if not a.tool:
            _err("--schema requires a tool name", 2)
        match = next((t for t in ns["list"]() if t.get("name") == a.tool), None)
        if match is None:
            _err(f"unknown tool: {a.tool}", 2)
        _emit(match.get("inputSchema", match.get("input_schema", {})))
        return

    if not a.tool:
        _err("tool name required (or use --list / --schema)", 2)
    try:
        arguments = json.loads(a.args) if a.args else {}
    except json.JSONDecodeError as e:
        _err(f"invalid --args JSON: {e}", 2)
    if not isinstance(arguments, dict):
        _err("--args must be a JSON object", 2)

    try:
        result = ns["exec"](a.tool, arguments)
    except urllib.error.HTTPError as e:
        if e.code == 500 and a.tool == "atelier_dispatch_mission":
            _dispatch_500_fallback(arguments)
        _err(f"backend HTTP {e.code}: {e.read().decode()[:300]}", 1)
    except Exception as e:  # noqa: BLE001
        _err(f"{type(e).__name__}: {e}", 1)
    _emit(result)
    # Ferme la boucle feedback qubik (best-effort, après l'output) — voir _maybe_autoclose
    _maybe_autoclose(a.tool, result)
    if _is_applicative_failure(result):
        raise SystemExit(1)


if __name__ == "__main__":
    main()
