#!/usr/bin/env python3
"""ubik — unified one-shot CLI router for the UBIK tool surface ("forge ring" in bash).

Mirrors the MCP gateway's namespace routing, but as a bash command with zero
context-token cost at rest. Each namespace forwards to the same backend the
MCP proxy uses, so behavior matches the gateway tool.

Usage:
    ubik <namespace> <tool> --args '<json-object>'   # invoke a tool
    ubik <namespace> --list                          # list tools (name + description)
    ubik <namespace> <tool> --schema                 # print a tool's JSON input schema
    ubik --namespaces                                # list available namespaces
"""
import argparse
import json
import os
import sys
import urllib.request
import urllib.error

# Resolve install paths from the script's REAL location (robust under any HOME:
# fleet agents run with HOME=~/.fleet/<id>, where "~/workspace" resolves wrong).
REPO = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))  # .../workspace/ubik-mcp
_REAL_HOME = os.path.dirname(os.path.dirname(REPO))                  # operator home

AGENT_BASE = os.environ.get("UBIK_BACKEND", "http://127.0.0.1:8765")
ENGINE_BASE = os.environ.get("UBIK_ENGINE_URL", "http://127.0.0.1:8801")
RELAY_BASE = os.environ.get("RELAY_URL", "http://127.0.0.1:7894")
ENGINE_SCHEMAS = os.environ.get(
    "UBIK_ENGINE_SCHEMAS",
    os.path.join(REPO, "data", "engine-bridge-schemas.json"),
)


def _agent_headers():
    """Replicate the MCP proxy identity headers so backend lead-only guards
    authorize CLI calls (x-ubik-caller-agent-id) — fleet agents set UBIK_AGENT_ID."""
    h = {}
    caller = os.environ.get("UBIK_AGENT_ID", "")
    if caller:
        h["x-ubik-caller-agent-id"] = caller
    try:
        cfg = json.load(open(os.path.join(_REAL_HOME, ".ubik-agent", "config.json")))
        if cfg.get("token"):
            h["x-ubik-agent-token"] = cfg["token"]
    except Exception:
        pass
    return h


def _http(method, url, body=None, timeout=60, headers=None):
    data = json.dumps(body).encode() if body is not None else None
    h = {"Content-Type": "application/json"}
    if headers:
        h.update(headers)
    req = urllib.request.Request(url, data=data, method=method, headers=h)
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read().decode()


# ---- agent namespace: proxy to UBIK backend :8765 (uniform execute endpoint) ----
def agent_list():
    d = json.loads(_http("GET", f"{AGENT_BASE}/api/tools/discover", timeout=10,
                         headers=_agent_headers()))
    return d if isinstance(d, list) else d.get("tools", d.get("result", []))


def agent_exec(tool, args):
    d = json.loads(_http("POST", f"{AGENT_BASE}/api/tools/execute",
                         {"tool": tool, "input": args}, headers=_agent_headers()))
    return d.get("result", d) if isinstance(d, dict) else d


# ---- engine namespace: proxy to ENGINE :8801 (uniform call endpoint) ----
def engine_list():
    return json.load(open(ENGINE_SCHEMAS, encoding="utf-8"))


def engine_exec(tool, args):
    d = json.loads(_http("POST", f"{ENGINE_BASE}/v1/tools/call",
                         {"name": tool, "args": args}))
    if isinstance(d, dict) and "result" in d:
        return d["result"]
    return d


# ---- generic stdio one-shot client: spawn the real MCP server, handshake, call ----
def _stdio_call(command, request, env_extra=None):
    """Spawn an MCP stdio server (`command` = argv list), do an initialize
    handshake, send `request` (id=2), return the matching JSON-RPC response.
    Runs the real server code => zero drift vs the gateway (same command).
    `env_extra` is an optional callable returning extra env vars (e.g. tokens)."""
    import subprocess, threading
    init = {"jsonrpc": "2.0", "id": 1, "method": "initialize",
            "params": {"protocolVersion": "2024-11-05", "capabilities": {},
                       "clientInfo": {"name": "ubik-cli", "version": "1"}}}
    inited = {"jsonrpc": "2.0", "method": "notifications/initialized"}
    payload = "\n".join(json.dumps(m) for m in (init, inited, request)) + "\n"
    # Match the gateway's runtime: use its nvm Node so tsx/node resolve identically
    # (avoids node-version drift in tool output) and inherit env (tokens come from
    # the caller's environment / per-server config, same as the gateway spawn).
    env = dict(os.environ)
    # Spawn operator-level MCP servers AS the operator: HOME drives python user-site
    # (the `mcp` module), npm/nvm, configs. Agent identity flows via UBIK_AGENT_ID env,
    # not HOME — so this is safe and fixes fleet-home spawns (HOME=~/.fleet/<id> lacks mcp).
    env["HOME"] = _REAL_HOME
    for node_bin in (os.path.join(_REAL_HOME, ".nvm/versions/node/v24.14.0/bin"),):
        if os.path.isdir(node_bin):
            env["PATH"] = node_bin + os.pathsep + env.get("PATH", "")
            break
    if env_extra:
        env.update(env_extra())
    # Client-driven lifecycle (do NOT use subprocess.run(input=...), which closes
    # stdin immediately): writing all messages then closing stdin makes the MCP
    # stdio server see EOF and tear down the session, which races the in-flight
    # request handler's response write. The server starts the call (its side
    # effect — e.g. a relay /send enqueue — fires) but the JSON-RPC reply is
    # dropped before flush → "no response" raised here ~10% of the time → the
    # caller double-sends an already-delivered DM. Repro'd 3/30; keeping stdin
    # open until the id=2 reply is read, then tearing down, is 0/30.
    proc = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, text=True, cwd=REPO, env=env)
    try:
        proc.stdin.write(payload)
        proc.stdin.flush()
    except (BrokenPipeError, ValueError):
        pass
    # Drain stderr concurrently so a chatty server (FastMCP logs each call) can't
    # fill the pipe and block the child before it answers.
    err_buf = []
    err_th = threading.Thread(target=lambda: err_buf.append(proc.stderr.read() or ""),
                              daemon=True)
    err_th.start()
    result = {"resp": None}
    def _read_resp():
        for line in proc.stdout:
            line = line.strip()
            if not line.startswith("{"):
                continue
            try:
                m = json.loads(line)
            except json.JSONDecodeError:
                continue
            if m.get("id") == 2:
                result["resp"] = m
                return
    read_th = threading.Thread(target=_read_resp, daemon=True)
    read_th.start()
    read_th.join(120)
    # Reply captured (or timed out): now it is safe to close stdin and stop the
    # server — the response write, if any, already happened.
    try:
        if proc.stdin and not proc.stdin.closed:
            proc.stdin.close()
        proc.terminate()
        proc.wait(timeout=5)
    except Exception:
        try:
            proc.kill()
        except Exception:
            pass
    if result["resp"] is not None:
        return result["resp"]
    err_th.join(2)
    err = ("".join(err_buf))[-300:]
    raise RuntimeError(f"no response from {command[-1]}; stderr={err}")


def _make_stdio(command, env_extra=None):
    def _list():
        r = _stdio_call(command, {"jsonrpc": "2.0", "id": 2, "method": "tools/list"}, env_extra)
        return r.get("result", {}).get("tools", [])

    def _exec(tool, args):
        r = _stdio_call(command, {"jsonrpc": "2.0", "id": 2, "method": "tools/call",
                                      "params": {"name": tool, "arguments": args}}, env_extra)
        res = r.get("result", {})
        txt = (res.get("content") or [{}])[0].get("text", "")
        if res.get("isError"):
            return f"[error] {txt}"
        try:
            return json.loads(txt)
        except (json.JSONDecodeError, TypeError):
            return txt

    return {"list": _list, "exec": _exec}


# Self-contained TS servers run one-shot via stdio (slower ~1.5s tsx startup, but
# infrequent + runs the real server code). Covers point 3 (TS) and point 4.
def _tsx(f):
    return ["npx", "-y", "tsx", f"src/servers/{f}"]

STDIO = {
    "github": _tsx("github.ts"), "linkedin": _tsx("linkedin.ts"), "review": _tsx("review.ts"),
    "system": _tsx("system.ts"), "lba": _tsx("lba.ts"),
    "skills": _tsx("skills.ts"), "crawl": _tsx("crawl.ts"),
    "google": _tsx("google.ts"), "microsoft": _tsx("microsoft.ts"),
    "lba-backend": _tsx("lba-backend.ts"),
    "relay": ["python3", os.path.join(_REAL_HOME, "workspace/ubik-fleet/fleet/starters/mcp_relay.py")],
    # workspace namespace (2026-06-20, politique CLI Damien): expose qubik_record_usage +
    # qubik_suggest (STEP-0 feedback/auto-equip) au CLI apres le drop du MCP ubik cote worker.
    # cold-spawn par appel (agent_workspace_* y figurent aussi, Docker = infrequent, OK).
    "workspace": ["python3", os.path.join(REPO, "agents-local", "workspace-server.py")],
}

# ---- memory namespace: in-process via the ubik_memory package (same dispatch as
# the `ubik-memory tool` CLI and the old memory.* MCP tools) ----
def memory_list():
    import asyncio
    from ubik_memory import mcp_server  # lazy: pulls duckdb only for `ubik memory`
    tools = asyncio.run(mcp_server.list_tools())
    return [{"name": t.name, "description": t.description or "",
             "inputSchema": getattr(t, "inputSchema", {}) or {}} for t in tools]


def memory_exec(tool, args):
    from ubik_memory import mcp_server  # lazy
    out = mcp_server.run_tool_text(tool, args)
    try:
        return json.loads(out)
    except (json.JSONDecodeError, TypeError):
        return out


NAMESPACES = {
    "memory": {"list": memory_list, "exec": memory_exec},
    "agent":  {"list": agent_list,  "exec": agent_exec},
    "engine": {"list": engine_list, "exec": engine_exec},
}
def _gh_token_env():
    """github.ts wants GITHUB_TOKEN; the gateway never wires it (REST tools 401).
    Reuse the already-authenticated gh CLI token — secret-safe, nothing stored."""
    import subprocess
    try:
        t = subprocess.run(["gh", "auth", "token"], capture_output=True, text=True, timeout=5).stdout.strip()
        return {"GITHUB_TOKEN": t} if t else {}
    except Exception:
        return {}

ENV_HOOKS = {"github": _gh_token_env}
for _n, _cmd in STDIO.items():
    NAMESPACES[_n] = _make_stdio(_cmd, ENV_HOOKS.get(_n))


# ---- relay namespace: mcp_relay.py exposes relay_send/relay_read/... over stdio,
# but NOT fleet_listen (the blocking long-poll). It lives in a separate MCP server
# (ubik-desktop-tools), so a CLI-only fleet home had no way to long-poll the inbox.
# Add it here as a direct HTTP GET to :7894/wait/<id>?timeout=N — leaner than
# spawning the stdio server for a hot-path long-poll (LEAD loops dispatch→listen).
_FLEET_LISTEN_SCHEMA = {
    "type": "object",
    "properties": {
        "agent_id": {"type": "string",
                     "description": "Agent whose inbox to long-poll (defaults to "
                                    "RELAY_AGENT_ID/UBIK_AGENT_ID env)."},
        "timeout": {"type": "integer", "default": 60,
                    "description": "Long-poll seconds, clamped to [1, 60]."},
    },
    "required": [],
}


def _relay_fleet_listen(args):
    """Block until a message is queued for agent_id (or timeout), then return the
    peeked inbox. Mirrors ubik-desktop-tools fleet_listen: GET /wait/<id>?timeout=N.
    Peeks without consuming — use `relay relay_read` to drain the queue."""
    agent_id = (args.get("agent_id")
                or os.environ.get("RELAY_AGENT_ID")
                or os.environ.get("UBIK_AGENT_ID", ""))
    if not agent_id:
        return "[error] fleet_listen requires agent_id (or RELAY_AGENT_ID/UBIK_AGENT_ID env)"
    try:
        timeout = int(args.get("timeout", 60))
    except (TypeError, ValueError):
        timeout = 60
    timeout = max(1, min(60, timeout))
    url = f"{RELAY_BASE}/wait/{agent_id}?timeout={timeout}"
    out = _http("GET", url, timeout=timeout + 5)
    try:
        return json.loads(out)
    except (json.JSONDecodeError, TypeError):
        return out


def _wrap_relay(base):
    def _list():
        tools = list(base["list"]())
        tools.append({"name": "fleet_listen",
                      "description": "Blocking long-poll of an agent's relay inbox "
                                     "(GET :7894/wait). Returns queued messages or "
                                     "empty after timeout. Peeks without consuming.",
                      "inputSchema": _FLEET_LISTEN_SCHEMA})
        return tools

    def _exec(tool, args):
        if tool == "fleet_listen":
            return _relay_fleet_listen(args)
        return base["exec"](tool, args)

    return {"list": _list, "exec": _exec}


NAMESPACES["relay"] = _wrap_relay(NAMESPACES["relay"])


# ---- workshop namespace: direct HTTP REST to UBIK backend :8765 ----
_WORKSHOP_TOOLS = [
    {"name": "list",
     "description": "List all workshops.",
     "inputSchema": {"type": "object", "properties": {}}},
    {"name": "show",
     "description": "Show a workshop by id.",
     "inputSchema": {"type": "object", "required": ["id"],
                     "properties": {"id": {"type": "string", "description": "Workshop id"}}}},
    {"name": "create",
     "description": "Create a new workshop (lead|operator only).",
     "inputSchema": {"type": "object", "required": ["name"],
                     "properties": {
                         "id":      {"type": "string", "description": "Optional stable id (e.g. ws-primus)"},
                         "name":    {"type": "string"},
                         "members": {"type": "array", "items": {"type": "string"}},
                         "lead":    {"type": "string"},
                     }}},
    {"name": "rename",
     "description": "Rename a workshop (lead|operator only).",
     "inputSchema": {"type": "object", "required": ["id", "name"],
                     "properties": {"id": {"type": "string"}, "name": {"type": "string"}}}},
    {"name": "lead-set",
     "description": "Set the lead of a workshop (lead|operator only).",
     "inputSchema": {"type": "object", "required": ["id", "lead"],
                     "properties": {"id": {"type": "string"}, "lead": {"type": "string"}}}},
    {"name": "member-add",
     "description": "Add a member to a workshop (lead|operator only).",
     "inputSchema": {"type": "object", "required": ["id", "member"],
                     "properties": {"id": {"type": "string"}, "member": {"type": "string"}}}},
    {"name": "member-remove",
     "description": "Remove a member from a workshop (lead|operator only).",
     "inputSchema": {"type": "object", "required": ["id", "member"],
                     "properties": {"id": {"type": "string"}, "member": {"type": "string"}}}},
    {"name": "dissolve",
     "description": "Dissolve (permanently delete) a workshop (lead|operator only).",
     "inputSchema": {"type": "object", "required": ["id"],
                     "properties": {"id": {"type": "string"}}}},
]


def _workshop_exec(tool, args):
    h = _agent_headers()
    ws_id = args.get("id", "")
    if tool == "list":
        out = _http("GET", f"{AGENT_BASE}/workshops", headers=h)
    elif tool == "show":
        out = _http("GET", f"{AGENT_BASE}/workshops/{ws_id}", headers=h)
    elif tool == "create":
        out = _http("POST", f"{AGENT_BASE}/workshops", args, headers=h)
    elif tool == "rename":
        out = _http("PATCH", f"{AGENT_BASE}/workshops/{ws_id}",
                    {"name": args.get("name")}, headers=h)
    elif tool == "lead-set":
        out = _http("PATCH", f"{AGENT_BASE}/workshops/{ws_id}",
                    {"lead": args.get("lead")}, headers=h)
    elif tool == "member-add":
        out = _http("PATCH", f"{AGENT_BASE}/workshops/{ws_id}",
                    {"member_add": args.get("member")}, headers=h)
    elif tool == "member-remove":
        out = _http("PATCH", f"{AGENT_BASE}/workshops/{ws_id}",
                    {"member_remove": args.get("member")}, headers=h)
    elif tool == "dissolve":
        out = _http("DELETE", f"{AGENT_BASE}/workshops/{ws_id}", headers=h)
    else:
        return f"[error] unknown workshop tool: {tool}"
    try:
        return json.loads(out)
    except (json.JSONDecodeError, TypeError):
        return out


NAMESPACES["workshop"] = {
    "list": lambda: _WORKSHOP_TOOLS,
    "exec": _workshop_exec,
}


# ---- docs namespace: DOCS DRIVE (KB de référence curée), REST vers backend :8765 ----
# Route vers l'API backend (et NON le module ubik_memory.docs_drive en local) :
# le backend tourne en HOME opérateur (systemd) donc tape le drive ~/.ubik-docs
# de l'opérateur. Un agent fleet shellant le module verrait son propre HOME de
# slot (drive vide) — prod-home-trap. Lecture = search/read/ls/tree/stats ;
# écriture/curation = mkdir/move/rename/ingest/rm.
_DOCS_TOOLS = [
    {"name": "stats", "description": "DOCS DRIVE: counts (files, chunks, embeddings).",
     "inputSchema": {"type": "object", "properties": {}}},
    {"name": "search", "description": "DOCS DRIVE: recherche sémantique dans la KB de référence.",
